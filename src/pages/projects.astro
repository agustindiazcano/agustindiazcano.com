---
import Layout from "../layouts/Layout.astro";
import Footer from "../components/Footer.astro";
// Defining projects localy to mirror the source of truth in [slug].astro
const projects = [
  {
    title: "lorem",
    slug: "zombie-mod-men-of-war",
    description: "Lorem ipsum.",
    tags: ["RTS"],
    year: "2015",
  }
];
---

<Layout 
  title="Projects | Agustin Diaz-Cano"
  description="Engineering portfolio: High-frequency trading, game development, and distributed systems projects by Agustin Diaz-Cano."
>
  <main class="min-h-screen max-w-[800px] mx-auto px-6 pb-20">

    <section class="mb-16">
      <h2 class="text-3xl font-bold tracking-tight text-white mb-3">
        Projects
      </h2>

    </section>

    <div class="space-y-12">
      {
        projects.map((project) => (
          <article class="group relative">
            <div class="flex justify-between items-baseline mb-2">
              <h2 class="text-xl font-semibold text-white group-hover:text-blue-400 transition-colors">
                <a
                  href={`/projects/${project.slug}`}
                  class="absolute inset-0 z-10 focus:outline-none"
                >
                  <span class="sr-only">View - {project.title}</span>
                </a>
                {project.title}
              </h2>
              <span class="text-sm font-mono text-[#444]">{project.year}</span>
            </div>
            <p class="text-[#666] text-sm leading-relaxed relative z-20 pointer-events-none mb-3">
              {project.description}
            </p>
            <div class="flex gap-2 relative z-20 pointer-events-none">
              {project.tags.map((tag) => (
                <span class="text-xs text-[#444] border border-[#222] px-1.5 py-0.5 rounded">
                  {tag}
                </span>
              ))}
            </div>
          </article>
        ))
      }
    </div>

    <div class="mt-32">
      <Footer />
    </div>
  </main>
</Layout>
