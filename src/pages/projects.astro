---
import Layout from "../layouts/Layout.astro";
import PageNav from "../components/PageNav.astro";
import Footer from "../components/Footer.astro";
import CSSBlackHole from "../components/CSSBlackHole.astro";
import ViewSwitch from "../components/ViewSwitch.astro";
import ItemsView from "../components/ItemsView.astro";
import { projects } from "../data/projects";

const items = projects.map((p) => ({
  href: `/projects/${p.slug}`,
  title: p.title,
  label: p.year,
  aside: p.tags.slice(0, 3).join(" / "),
  image: p.image,
  github: p.githubUrl,
  youtube: p.youtube,
  live: p.live,
}));
---

<Layout 
  title="Projects | Agustin Diaz-Cano"
  description="Software Engineer and MS Candidate, Systems Engineering at UTN, specialized in AI/ML and Backend. Explore my engineering portfolio of projects."
>
  <CSSBlackHole />
  <main class="page-fade-in min-h-screen max-w-[1200px] mx-auto px-6 pb-20 relative z-10">
        <PageNav items={[{ label: "Projects" }]} backHref="/" />

    <section class="mb-8 md:mb-12 flex items-end justify-between gap-4">
      <h2 class="text-3xl font-bold tracking-tight text-white text-center md:text-left">
        Projects
      </h2>
      <ViewSwitch />
    </section>

    <ItemsView items={items} />

    <div class="mt-32">
      <Footer />
    </div>
  </main>
</Layout>
