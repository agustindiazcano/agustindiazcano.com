---
import Layout from "../layouts/Layout.astro";
import Footer from "../components/Footer.astro";
// Defining projects localy to mirror the source of truth in [slug].astro
const projects = [
        {
            title: "MCP Transactional Agent",
            slug: "mcp-transactional-agent",
            description: "AI-driven transactional agent using Model Context Protocol to interact with complex APIs.",
            tags: ["AI", "LLMs", "Agentic Systems"],
            year: "2026",
        },
        {
            title: "Algorithmic Trading Engine",
            slug: "algorithmic-trading-engine",
            description: "Automated high-performance algorithmic trading system capable of processing market data and executing trades with low latency.",
            tags: ["Fintech", "Python", "Trading"],
            year: "2025",
        },
        {
            title: "AI & ML Research",
            slug: "ai-ml-research",
            description: "Academic experiments and proofs of concept focusing on physics simulations, neural networks, and optimization.",
            tags: ["AI", "ML", "Neural Networks", "Python"],
            year: "2024",
        },
        {
            title: "Astrophysics Data Simulations",
            slug: "astrophysics-data-simulations",
            description: "Developed robust simulations to model complex astrophysics systems, analyzing large datasets for scientific research.",
            tags: ["Data Science", "Physics", "Python"],
            year: "2023",
        },
        {
            title: "LATAM E-commerce Ecosystem",
            slug: "ecommerce-latam",
            description: "Scalable and localized e-commerce solution tailored for LATAM, handling complex payment gateways.",
            tags: ["Web Dev", "E-commerce", "React"],
            year: "2022",
        },
        {
            title: "InsurTech Quoting Engine",
            slug: "insurance-quoter",
            description: "Robust quoting engine and an intuitive user interface for calculating insurance premiums in real-time.",
            tags: ["Fintech", "TypeScript", "React"],
            year: "2021",
        },
        {
            title: "Game Dev: Modding Ecosystem",
            slug: "game-dev-modding",
            description: "220,000+ Downloads. Combining Zombie Mod and HD Mod across Men of War series.",
            tags: ["Game Dev", "3D Modeling"],
            year: "2015",
        },
        {
            title: "Alien Survival",
            slug: "alien-survival",
            description: "Challenging survival game where players must defend against alien swarms while managing limited resources.",
            tags: ["Game Dev", "C#", "Unity"],
            year: "2014",
        }
];
---

<Layout 
  title="Projects | Agustin Diaz-Cano"
  description="Software Engineer and Master's Candidate in Information Systems Engineering at UTN, specialized in AI/ML and Backend. Explore my engineering portfolio of projects."
>
  <main class="min-h-screen max-w-[800px] mx-auto px-6 pb-20">

    <section class="mb-16">
      <h2 class="text-3xl font-bold tracking-tight text-white mb-3">
        Projects
      </h2>

    </section>

    <div class="space-y-12">
      {
        projects.map((project) => (
          <article class="group relative">
            <div class="flex justify-between items-baseline mb-2">
              <h2 class="text-xl font-semibold text-white group-hover:text-blue-400 transition-colors">
                <a
                  href={`/projects/${project.slug}`}
                  class="absolute inset-0 z-10 focus:outline-none"
                >
                  <span class="sr-only">View - {project.title}</span>
                </a>
                {project.title}
              </h2>
              <span class="text-sm font-mono text-[#444]">{project.year}</span>
            </div>
            <p class="text-[#666] text-sm leading-relaxed relative z-20 pointer-events-none mb-3">
              {project.description}
            </p>
            <div class="flex gap-2 relative z-20 pointer-events-none">
              {project.tags.map((tag) => (
                <span class="text-xs text-[#444] border border-[#222] px-1.5 py-0.5 rounded">
                  {tag}
                </span>
              ))}
            </div>
          </article>
        ))
      }
    </div>

    <div class="mt-32">
      <Footer />
    </div>
  </main>
</Layout>
