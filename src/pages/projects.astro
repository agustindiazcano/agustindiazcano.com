---
import Layout from "../layouts/Layout.astro";
import PageNav from "../components/PageNav.astro";
import Footer from "../components/Footer.astro";
import CSSBlackHole from "../components/CSSBlackHole.astro";
import { projects } from "../data/projects";
---

<Layout 
  title="Projects | Agustin Diaz-Cano"
  description="Software Engineer and MS Candidate, Systems Engineering at UTN, specialized in AI/ML and Backend. Explore my engineering portfolio of projects."
>
  <CSSBlackHole />
  <main class="page-fade-in min-h-screen max-w-[1200px] mx-auto px-6 pb-20 relative z-10">
        <PageNav items={[{ label: "Projects" }]} backHref="/" />

    <section class="mb-8 md:mb-12">
      <h2 class="text-3xl font-bold tracking-tight text-white mb-3 text-center md:text-left">
        Projects
      </h2>

    </section>

    <ul class="divide-y divide-[#222] border-y border-[#222]">
      {
        projects.map((project) => (
          <li>
            <a href={`/projects/${project.slug}`} class="flex items-baseline gap-4 py-3 group">
              <span class="shrink-0 w-14 text-xs font-mono text-[#555]">{project.year}</span>
              <span class="min-w-0 flex-1 truncate text-sm md:text-base text-[#ccc] group-hover:text-white transition-colors">{project.title}</span>
              <span class="hidden md:block shrink-0 max-w-[40%] truncate text-xs font-mono text-[#555]">{project.tags.slice(0, 3).join(" / ")}</span>
            </a>
          </li>
        ))
      }
    </ul>

    <div class="mt-32">
      <Footer />
    </div>
  </main>
</Layout>
