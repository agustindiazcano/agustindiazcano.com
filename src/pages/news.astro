---
import Layout from "../layouts/Layout.astro";
import PageNav from "../components/PageNav.astro";
import Footer from "../components/Footer.astro";
import CSSBlackHole from "../components/CSSBlackHole.astro";

import { news } from "../data/news";
---

<Layout
  title="News | Agustin Diaz-Cano"
  description="Latest news and updates from Agustin Diaz-Cano, Software Engineer and MS Candidate, Systems Engineering."
>
  <CSSBlackHole />
  <main class="page-fade-in min-h-screen max-w-[1200px] mx-auto px-6 pb-20 relative z-10">
    <PageNav items={[{ label: "News" }]} backHref="/" />

    <section class="mb-8 md:mb-12">
      <h2 class="text-3xl font-bold tracking-tight text-white mb-3 text-center md:text-left">News</h2>
      <p class="text-[#888] text-center md:text-left">Latest updates</p>
    </section>

    {
      news.length === 0 ? (
        <p class="text-[#666] text-sm font-mono text-center md:text-left">No news yet.</p>
      ) : (
        <ul class="divide-y divide-[#222] border-y border-[#222]">
          {news.map((item) => (
            <li>
              {item.href ? (
                <a href={item.href} class="flex items-baseline gap-4 py-3 group">
                  <span class="shrink-0 w-24 text-xs font-mono text-[#555]">{item.date}</span>
                  <span class="min-w-0 flex-1 truncate text-sm md:text-base text-[#ccc] group-hover:text-white transition-colors">{item.title}</span>
                  <span class="hidden md:block shrink-0 max-w-[40%] truncate text-xs font-mono text-[#555]">{item.description}</span>
                </a>
              ) : (
                <div class="flex items-baseline gap-4 py-3">
                  <span class="shrink-0 w-24 text-xs font-mono text-[#555]">{item.date}</span>
                  <span class="min-w-0 flex-1 truncate text-sm md:text-base text-[#ccc]">{item.title}</span>
                  <span class="hidden md:block shrink-0 max-w-[40%] truncate text-xs font-mono text-[#555]">{item.description}</span>
                </div>
              )}
            </li>
          ))}
        </ul>
      )
    }
    <div class="mt-20">
      <Footer />
    </div>
  </main>
</Layout>
