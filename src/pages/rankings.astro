---
import Layout from "../layouts/Layout.astro";
import Footer from "../components/Footer.astro";
import CSSBlackHole from "../components/CSSBlackHole.astro";
import { rankingTiers, rankingsLastUpdated } from "../data/rankings";

const siteUrl = "https://www.agustindiazcano.com";
const pageUrl = `${siteUrl}/rankings`;
const title = "Rankings and Recognition | Agustin Diaz-Cano";
const description =
    "Verified third-party rankings, hackathon results and public metrics for Agustin Diaz-Cano, Software Engineer. Every entry links to its external source.";

const schema = {
    "@context": "https://schema.org",
    "@graph": [
        {
            "@type": "CollectionPage",
            "@id": `${pageUrl}#page`,
            url: pageUrl,
            name: title,
            description,
            inLanguage: "en",
            dateModified: rankingsLastUpdated,
            isPartOf: { "@type": "WebSite", url: siteUrl },
            about: { "@type": "Person", name: "Agustin Diaz-Cano", url: siteUrl },
            mainEntity: { "@id": `${pageUrl}#list` },
        },
        {
            "@type": "ItemList",
            "@id": `${pageUrl}#list`,
            itemListElement: rankingTiers
                .flatMap((tier) => tier.entries)
                .map((entry, index) => ({
                    "@type": "ListItem",
                    position: index + 1,
                    name: `${entry.platform}: ${entry.metric}`,
                    url: entry.url,
                })),
        },
        {
            "@type": "BreadcrumbList",
            itemListElement: [
                { "@type": "ListItem", position: 1, name: "Home", item: siteUrl },
                { "@type": "ListItem", position: 2, name: "Rankings", item: pageUrl },
            ],
        },
    ],
};
---

<Layout title={title} description={description} canonicalUrl={pageUrl}>
    <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, "\\u003c")} />
    <CSSBlackHole />
    <main class="page-fade-in min-h-screen max-w-[800px] mx-auto px-6 pb-20 relative z-10">
        <nav class="flex items-center gap-2 text-xs font-mono text-[#666] mb-6 pt-2" aria-label="Breadcrumb">
            <a href="/" class="hover:text-white transition-colors">HOME</a>
            <span aria-hidden="true">/</span>
            <span class="text-[#888]" aria-current="page">RANKINGS</span>
        </nav>

        <header class="mb-12">
            <h1 class="text-3xl md:text-4xl font-bold tracking-tight text-white mb-3">Rankings and Recognition</h1>
            <p class="text-[#888] leading-relaxed">
                External evidence for the work of Agustin Diaz-Cano. Every row names the metric, the platform and the date it was checked, and links to the original source so it can be verified in one click.
            </p>
            <p class="font-mono text-[11px] text-[#555] mt-3">
                Last updated <time datetime={rankingsLastUpdated}>{rankingsLastUpdated}</time>. Positions on third-party platforms change over time; each entry shows when it was checked.
            </p>
        </header>

        <div class="space-y-12">
            {
                rankingTiers.map((tier, tierIndex) => (
                    <section aria-labelledby={`tier-${tier.id}`}>
                        <p class="font-mono text-[11px] uppercase tracking-wider text-[#555] mb-1">Tier {tierIndex + 1}</p>
                        <h2 id={`tier-${tier.id}`} class="text-xl font-semibold text-white mb-1">{tier.title}</h2>
                        <p class="text-sm text-[#666] mb-5">{tier.description}</p>

                        <ul class="border border-[#222] rounded-2xl overflow-hidden divide-y divide-[#222] bg-[#111]">
                            {tier.entries.map((entry) => (
                                <li>
                                    <a
                                        href={entry.url}
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        class="group flex flex-col gap-1 px-4 py-4 transition-colors hover:bg-[#161616] focus-visible:outline focus-visible:outline-2 focus-visible:outline-[#68d6ba]"
                                    >
                                        <span class="flex items-baseline justify-between gap-4">
                                            <span class="text-sm font-semibold text-white group-hover:text-[#68d6ba] transition-colors">
                                                {entry.platform}
                                            </span>
                                            <span class="font-mono text-[11px] text-[#555] whitespace-nowrap">
                                                {entry.source} <span aria-hidden="true">↗</span>
                                            </span>
                                        </span>
                                        <span class="font-mono text-xs text-[#68d6ba]">{entry.metric}</span>
                                        <span class="text-sm text-[#888] leading-relaxed">{entry.detail}</span>
                                        {entry.method && (
                                            <span class="text-xs text-[#666] leading-relaxed border-l border-[#333] pl-3 mt-1">{entry.method}</span>
                                        )}
                                        <span class="font-mono text-[10px] text-[#555]">
                                            Checked <time datetime={entry.checked}>{entry.checked}</time>
                                        </span>
                                    </a>
                                </li>
                            ))}
                        </ul>
                    </section>
                ))
            }
        </div>

        <p class="mt-12 text-sm text-[#666]">
            See also the <a href="/agents-usage" class="text-[#888] underline underline-offset-4 hover:text-white transition-colors">AI Usage dashboard</a> and the <a href="/profile" class="text-[#888] underline underline-offset-4 hover:text-white transition-colors">full profile</a>.
        </p>

        <div class="mt-20">
            <Footer />
        </div>
    </main>
</Layout>
