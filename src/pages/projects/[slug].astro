---
import Layout from "../../layouts/Layout.astro";
import PageNav from "../../components/PageNav.astro";
import Footer from "../../components/Footer.astro";
import CardLinks from "../../components/CardLinks.astro";
import { projectPages } from "../../data/projects";

export async function getStaticPaths() {
    return projectPages.map((project) => ({
        params: { slug: project.slug },
        props: { project },
    }));
}

const { project } = Astro.props;
const images = project.images ?? [];
// The cover is shown at the top; the rest go in the gallery
const gallery = images
    .map((src, i) => ({ src, alt: project.imageAlts?.[i] ? `${project.title} by Agustin Diaz-Cano: ${project.imageAlts[i]}` : `${project.title} by Agustin Diaz-Cano, image ${i + 1}` }))
    .filter((img) => img.src !== project.image);
---

<Layout
  title={`${project.title} | Agustin Diaz-Cano`}
  description={`${project.description} A project by Agustin Diaz-Cano.`}
>
    <main class="min-h-screen max-w-[1200px] mx-auto px-6 pb-20">

        <PageNav items={[{ label: "Projects", href: "/projects" }, { label: project.title }]} backHref="/projects" />

        <header class="mb-12">
            {
                project.image && (
                    <div class="w-full aspect-[16/9] md:aspect-[21/9] bg-[#111] rounded-2xl border border-[#222] mb-8 relative overflow-hidden">
                        <img
                            src={project.image}
                            alt={`${project.title} by Agustin Diaz-Cano`}
                            class="absolute inset-0 w-full h-full object-cover"
                        />
                    </div>
                )
            }

            <h1 class="text-3xl md:text-5xl font-bold tracking-tight text-white mb-4">
                {project.title}
            </h1>

            <div class="flex flex-wrap items-center gap-2 mb-8">
                {project.year && <span class="text-xs font-mono text-[#efd98a] mr-2">{project.year}</span>}
                {
                    project.tags.map((tag) => (
                        <span class="text-xs text-[#888] border border-[#333] px-2 py-1 rounded bg-[#0a0a0a]">
                            {tag}
                        </span>
                    ))
                }
            </div>

            <p class="text-lg md:text-xl text-[#aaa] leading-relaxed max-w-3xl mb-8">
                {project.description}
            </p>

            <CardLinks
                labels
                title={project.title}
                github={project.githubUrl}
                gitlab={project.gitlab}
                youtube={project.youtube}
                live={project.live}
            />
        </header>

        {
            project.body && project.body.length > 0 && (
                <article class="max-w-3xl space-y-5 text-[#999] text-base md:text-lg leading-relaxed mb-12">
                    {project.body.map((paragraph) => (
                        <p>{paragraph}</p>
                    ))}
                </article>
            )
        }

        {
            gallery.length > 0 && (
                <section class="mb-12" aria-label="Project gallery">
                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
                        {gallery.map((img) => (
                            <img
                                src={img.src}
                                alt={img.alt}
                                loading="lazy"
                                class="w-full aspect-[16/10] object-cover rounded-xl border border-[#222] bg-[#111]"
                            />
                        ))}
                    </div>
                </section>
            )
        }

        <div class="mt-20">
            <Footer />
        </div>
    </main>
</Layout>
