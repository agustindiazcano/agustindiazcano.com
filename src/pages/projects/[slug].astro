---
import Layout from "../../layouts/Layout.astro";
import Footer from "../../components/Footer.astro";

export async function getStaticPaths() {
    const projects = [
        {
            slug: "mcp-transactional-agent",
            title: "MCP Transactional Agent",
            description: "AI-driven transactional agent using Model Context Protocol.",
            tags: ["AI", "LLMs", "Agentic Systems"],
        },
        {
            slug: "memory-constrained-llm-optimization",
            title: "Memory-Constrained LLM Optimization (OpenAI Parameter Golf)",
            description: "Exploration into memory-constrained LLM optimization using OpenAI APIs and parameter golf techniques.",
            tags: ["AI", "LLMs", "Optimization", "Python"],
        },
        {
            slug: "algorithmic-trading-engine",
            title: "Algorithmic Trading Engine",
            description: "Automated trading system for financial markets.",
            tags: ["Fintech", "Python", "Trading"],
        },
        {
            slug: "ai-ml-research",
            title: "AI & ML Research",
            description: "A collection of academic experiments and proofs of concept focusing on physics simulations, neural networks, and optimization.",
            tags: ["AI", "ML", "Neural Networks", "Python"],
        },
        {
            slug: "astrophysics-data-simulations",
            title: "Astrophysics Data Simulations",
            description: "Simulations of astrophysical phenomena and data analysis.",
            tags: ["Data Science", "Physics", "Python"],
        },
        {
            slug: "ecommerce-latam",
            title: "LATAM E-commerce Ecosystem",
            description: "E-commerce platform for the Latin American market.",
            tags: ["Web Dev", "E-commerce", "React"],
        },
        {
            slug: "insurance-quoter",
            title: "InsurTech Quoting Engine",
            description: "Dynamic insurance quoting engine and frontend.",
            tags: ["Fintech", "TypeScript", "React"],
        },
        {
            slug: "go-async-order-processor",
            title: "Go Async Order Processor",
            description: "High-throughput asynchronous order processing engine built with Go.",
            tags: ["Backend", "Go", "Concurrency"],
        },
        {
            slug: "game-dev-modding",
            title: "Game Dev: Modding Ecosystem",
            description: "220,000+ Downloads. Combining Zombie Mod and HD Mod across Men of War series.",
            tags: ["Game Dev", "3D Modeling"],
        },
        {
            slug: "alien-survival",
            title: "Alien Survival",
            description: "Survival game focusing on resource management and base building.",
            tags: ["Game Dev", "C#", "Unity"],
        },
        {
            slug: "portfolio",
            title: "Agustin Diaz-Cano Portfolio",
            description: "Personal website and portfolio built with Astro, React, and Tailwind CSS v4.",
            tags: ["Astro", "React", "Tailwind CSS"],
        }
    ];

    return projects.map((project) => ({
        params: { slug: project.slug },
        props: { project },
    }));
}

const { project } = Astro.props;
---

<Layout 
  title={`${project.title} | Agustin Diaz-Cano`}
  description={`${project.description} — A project by Agustin Diaz-Cano.`}
>
    <main class="min-h-screen max-w-[1000px] mx-auto px-6 pb-20">

        <div class="mb-8">
            <a
                href="/projects"
                class="text-[#666] hover:text-white transition-colors text-sm inline-flex items-center gap-1"
                >← Back to Projects</a
            >
        </div>

        <header class="mb-12">

            <div
                class="h-64 w-full bg-[#111] rounded-2xl border border-[#222] mb-8 relative overflow-hidden flex items-center justify-center"
            >
                <div
                    class="absolute inset-0 bg-[url('/grid-pattern.svg')] opacity-10"
                >
                </div>
                <span
                    class="text-[#333] font-bold text-4xl uppercase tracking-widest"
                    >Image Placeholder</span
                >
            </div>

            <h1
                class="text-4xl md:text-5xl font-bold tracking-tight text-white mb-4"
            >
                {project.title}
            </h1>

            <div class="flex flex-wrap gap-2 mb-8">
                {
                    project.tags.map((tag) => (
                        <span class="text-xs text-[#888] border border-[#333] px-2 py-1 rounded bg-[#0a0a0a]">
                            {tag}
                        </span>
                    ))
                }
            </div>

            <p
                class="text-xl text-[#888] leading-relaxed max-w-3xl border-l-2 border-blue-500 pl-6"
            >
                {project.description}
            </p>
        </header>

        <article class="prose prose-invert prose-lg max-w-none text-[#999]">
            <h2 class="text-white">Project Overview</h2>
            <p>
                Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do
                eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut
                enim ad minim veniam, quis nostrud exercitation ullamco laboris
                nisi ut aliquip ex ea commodo consequat.
            </p>

            <h3 class="text-white">Technical Challenges</h3>
            <p>
                Duis aute irure dolor in reprehenderit in voluptate velit esse
                cillum dolore eu fugiat nulla pariatur. Excepteur sint occaecat
                cupidatat non proident, sunt in culpa qui officia deserunt
                mollit anim id est laborum.
            </p>

            <ul class="list-disc pl-6 space-y-2 marker:text-blue-500">
                <li>High concurrency management</li>
                <li>Memory optimization for low-end devices</li>
                <li>Real-time state synchronization</li>
            </ul>

            <blockquote
                class="border-l-4 border-[#333] pl-4 italic text-[#666]"
            >
                "The complexity of this system required a complete rethink of
                the standard architecture."
            </blockquote>

            <p>
                Sed ut perspiciatis unde omnis iste natus error sit voluptatem
                accusantium doloremque laudantium.
            </p>
        </article>

        <div class="mt-20">
            <Footer />
        </div>
    </main>
</Layout>
