---
import Layout from "../layouts/Layout.astro";
import Footer from "../components/Footer.astro";

import RaceImageGallery from "../components/RaceImageGallery.jsx";



const races = [
    {
        name: "Medal - 42k Buenos Aires Matathon 2025 - Agustin Diaz-Cano",
        date: "2025",
        link: "https://www.linkedin.com/in/agustindiazcano",
        description: "Medal - 42k Buenos Aires Matathon 2025 - Agustin Diaz-Cano",
        images: [
            "/images/buenos-aires-marathon-42k-2025-agustin-diaz-cano-1.jpg",
            "/images/buenos-aires-marathon-42k-2025-agustin-diaz-cano-2.jpg",
            "/images/buenos-aires-marathon-42k-2025-agustin-diaz-cano-3.jpg"
        ]
    },
    {
        name: "Medal - 21k Mar del Plata 2025 - Agustin Diaz-Cano",
        date: "2025",
        description: "Medal - 21k Mar del Plata 2025 - Agustin Diaz-Cano",
        images: [
            "/images/21k-mar-del-plata-2025-agustin-diaz-cano-1.jpg",
            "/images/21k-mar-del-plata-2025-agustin-diaz-cano-2.jpg"
        ]
    },
    {
        name: "Medal - 15k Saucony 2025 - Agustin Diaz-Cano",
        date: "2025",
        link: "https://www.linkedin.com/in/agustindiazcano",
        description: "Medal - 15k Saucony 2025 - Agustin Diaz-Cano",
        images: [
            "/images/saucony-15k-2025-agustin-diaz-cano-1.jpg",
            "/images/saucony-15k-2025-agustin-diaz-cano-2.jpg"
        ]
    },
    {
        name: "Agustin Diaz Cano - 21k Buenos Aires Half Marathon",
        date: "2023",
        description: "Agustin Diaz Cano completing the 21k Buenos Aires Half Marathon",
        images: ["/images/21-buenos-aires-half-marathon-2023-agustin-diaz-cano.png"]
    },
    {
        name: "Medal - 42k Buenos Aires Matathon 2023 - Agustin Diaz-Cano",
        date: "2023",
        description: "Medal - 42k Buenos Aires Matathon 2023 - Agustin Diaz-Cano",
        images: ["/images/42k-buenos-aires-marathon-2023-agustin-diaz-cano-1.jpg"]
    },
    {
        name: "Medal - 15k New Balance 2023 - Agustin Diaz-Cano",
        date: "2023",
        description: "Medal - 15k New Balance 2023 - Agustin Diaz-Cano",
        images: [
            "/images/15k-new-balance-agustin-diaz-cano-1.jpg",
            "/images/15k-new-balance-agustin-diaz-cano-2.jpg"
        ]
    },
    {
        name: "Medal - 10k Bremen 2023 - Agustin Diaz-Cano",
        date: "2023",
        link: "https://www.linkedin.com/in/agustindiazcano",
        description: "Medal - 10k Bremen 2023 - Agustin Diaz-Cano",
        images: ["/images/san-silvestre-10k-bremen-agustin-diaz-cano-1.jpg"]
    },
    {
        name: "Agustin Diaz-Cano - Carrera Ciudad Verde 2019",
        date: "2019",
        description: "Agustin Diaz-Cano - Carrera Ciudad Verde 2019",
        images: ["/images/carrera-ciudad-verde-2021-agustin-diaz-cano-1.jpg"]
    },
    {
        name: "Agustin Diaz-Cano - Carrera Nocturna 2019",
        date: "2019",
        description: "Agustin Diaz-Cano - Carrera Nocturna 2019",
        images: ["/images/carrera-nocturna-2019-agustin-diaz-cano.jpg"]
    },
    {
        name: "Agustin Diaz-Cano - 21k Mar del Plata 2019",
        date: "2019",
        description: "Agustin Diaz-Cano - 21k Mar del Plata 2019",
        images: [
            "/images/21k-mar-del-plata-2019-agustin-diaz-cano-1.jpg",
            "/images/21k-mar-del-plata-2019-agustin-diaz-cano-2.jpg"
        ]
    },
    {
        name: "Agustin Diaz-Cano - 21k Mar del Plata 2018",
        date: "2018",
        description: "Agustin Diaz-Cano - 21k Mar del Plata 2018",
        images: ["/images/21k-mar-del-plata-2018-agustin-diaz-cano.jpg"]
    }
];
---

<Layout 
  title="Running Log & Marathons | Agustin Diaz-Cano"
  description="42k Marathon and running log of Agustin Diaz-Cano."
>
  <main class="min-h-screen max-w-[800px] mx-auto px-6 pb-20">

    <section class="mb-16">
      <h2 class="text-3xl font-bold tracking-tight text-white mb-3">Running Log</h2>
      <p class="text-[#888]">
        42k Marathons and road races.
      </p>
    </section>

    <div class="relative border-l border-[#333] ml-4 md:ml-6 pl-8 md:pl-12 space-y-16">
      {
        races.map((race) => (
          <article class="relative group">
            {/* Timeline Dot */}
            <div class="absolute -left-[41px] md:-left-[57px] top-1.5 w-5 h-5 rounded-full bg-[#111] border-4 border-[#333] group-hover:border-blue-500 transition-colors z-10"></div>
            
            <div class="flex flex-col md:flex-row gap-6">
                <div class="flex-1">
                    <div class="flex flex-wrap items-center gap-3 mb-2">
                        {race.link ? (
                            <a href={race.link} target="_blank" rel="noopener noreferrer" class="text-2xl font-bold text-white hover:text-blue-400 transition-colors inline-flex items-center gap-2">
                                {race.name}
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="opacity-50"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
                            </a>
                        ) : (
                            <h3 class="text-2xl font-bold text-white group-hover:text-blue-400 transition-colors">{race.name}</h3>
                        )}
                        {(() => {
                            const dMatch = race.name.match(/\b(42k|21k|15k|10k)\b/i);
                            const distance = dMatch ? dMatch[1].toLowerCase() : "10k";
                            const is42k = distance === "42k";
                            return (
                                <span class={`text-xs font-mono font-semibold px-2.5 py-0.5 rounded-full uppercase tracking-wider transition-all duration-300 ${
                                    is42k 
                                    ? "bg-gradient-to-r from-yellow-500/20 to-amber-500/20 text-yellow-400 border border-yellow-500/50 shadow-[0_0_12px_rgba(234,179,8,0.3)] group-hover:shadow-[0_0_20px_rgba(234,179,8,0.5)]" 
                                    : "text-[#888] bg-[#111] border border-[#333] group-hover:border-[#555]"
                                }`}>
                                    {distance}
                                </span>
                            );
                        })()}
                    </div>
                    <div class="text-sm font-mono text-[#888] mb-4 flex flex-wrap gap-4">
                        {race.date && (
                            <span class="flex items-center gap-1.5"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg> {race.date}</span>
                        )}
                    </div>
                    <p class="text-[#999] leading-relaxed mb-6">
                        {race.description}
                    </p>
                </div>
                
                <RaceImageGallery client:load images={race.images} title={race.name} />
            </div>
          </article>
        ))
      }
    </div>
    
    <div class="mt-24 border-t border-[#222] pt-12">
        <div class="p-6 rounded-2xl border border-[#222] bg-[#111]/50 flex flex-col md:flex-row items-center justify-between gap-6 hover:border-[#444] transition-colors">
            <div>
                <h4 class="text-white font-semibold mb-2">Strava / Garmin Connect</h4>
                <p class="text-[#888] text-sm">Follow my daily training and weekly mileage.</p>
            </div>
            <a href="#" class="px-6 py-2.5 rounded-lg bg-white text-black font-semibold hover:bg-[#ddd] transition-colors whitespace-nowrap text-sm text-center">
                Follow on Strava
            </a>
        </div>
    </div>

    <div class="mt-20">
      <Footer />
    </div>
  </main>
</Layout>
