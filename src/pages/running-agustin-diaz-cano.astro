---
import Layout from "../layouts/Layout.astro";
import Footer from "../components/Footer.astro";

const races = [
    {
        name: "Maratón de Buenos Aires",
        date: "September 2026",
        location: "Buenos Aires, Argentina",
        time: "03:14:52",
        type: "42k",
        image: "/images/marathon_ba.jpg",
        description: "A grueling but beautiful course through the heart of Buenos Aires. Achieved a personal best despite the humidity."
    },
    {
        name: "Media Maratón de la Ciudad",
        date: "August 2025",
        location: "Buenos Aires, Argentina",
        time: "01:28:40",
        type: "21k",
        image: "/images/half_marathon.jpg",
        description: "Great pacing throughout the race. The early morning start was perfectly cool and the route over the highway was spectacular."
    }
];
---

<Layout 
  title="Running Log & Marathons | Agustin Diaz-Cano"
  description="42k Marathon and running log of Agustin Diaz-Cano."
>
  <main class="min-h-screen max-w-[800px] mx-auto px-6 pb-20">

    <section class="mb-16">
      <h2 class="text-3xl font-bold tracking-tight text-white mb-3">Running Log</h2>
      <p class="text-[#888]">
        42k Marathons and road races.
      </p>
    </section>

    <div class="relative border-l border-[#333] ml-4 md:ml-6 pl-8 md:pl-12 space-y-16">
      {
        races.map((race) => (
          <article class="relative group">
            {/* Timeline Dot */}
            <div class="absolute -left-[41px] md:-left-[57px] top-1.5 w-5 h-5 rounded-full bg-[#111] border-4 border-[#333] group-hover:border-blue-500 transition-colors z-10"></div>
            
            <div class="flex flex-col md:flex-row gap-6">
                <div class="flex-1">
                    <div class="flex flex-wrap items-baseline gap-3 mb-2">
                        <h3 class="text-2xl font-bold text-white group-hover:text-blue-400 transition-colors">{race.name}</h3>
                        <span class="text-xs font-mono text-[#666] border border-[#333] px-2 py-0.5 rounded-full bg-[#111] uppercase">{race.type}</span>
                    </div>
                    <div class="text-sm font-mono text-[#888] mb-4 flex flex-wrap gap-4">
                        <span class="flex items-center gap-1.5"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg> {race.date}</span>
                        <span class="flex items-center gap-1.5"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg> {race.location}</span>
                        <span class="text-white font-semibold flex items-center gap-1.5"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="10" x2="14" y1="2" y2="2"/><line x1="12" x2="15" y1="14" y2="11"/><circle cx="12" cy="14" r="8"/></svg> {race.time}</span>
                    </div>
                    <p class="text-[#999] leading-relaxed mb-6">
                        {race.description}
                    </p>
                </div>
                
                {race.image && (
                    <div class="w-full md:w-64 shrink-0 rounded-xl overflow-hidden border border-[#222] bg-[#111]">
                        <img src={race.image} alt={race.name} class="w-full h-full object-cover aspect-video md:aspect-square opacity-90 group-hover:opacity-100 transition-opacity" />
                    </div>
                )}
            </div>
          </article>
        ))
      }
    </div>
    
    <div class="mt-24 border-t border-[#222] pt-12">
        <div class="p-6 rounded-2xl border border-[#222] bg-[#111]/50 flex flex-col md:flex-row items-center justify-between gap-6 hover:border-[#444] transition-colors">
            <div>
                <h4 class="text-white font-semibold mb-2">Strava / Garmin Connect</h4>
                <p class="text-[#888] text-sm">Follow my daily training and weekly mileage.</p>
            </div>
            <a href="#" class="px-6 py-2.5 rounded-lg bg-white text-black font-semibold hover:bg-[#ddd] transition-colors whitespace-nowrap text-sm text-center">
                Follow on Strava
            </a>
        </div>
    </div>

    <div class="mt-20">
      <Footer />
    </div>
  </main>
</Layout>
