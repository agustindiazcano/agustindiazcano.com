---
import Layout from "../../layouts/Layout.astro";
import Footer from "../../components/Footer.astro";

export async function getStaticPaths() {
    const publications = [
        {
            slug: "bug-triage-system",
            title: "Artificial Intelligence Based Bug Triage System",
            description: "Knowledge Engineering & Fuzzy Logic",
            content: `Course: Intelligent Data Exploitation (Aprovechamiento Inteligente de Datos), UTN MSc
Instructors: Cinthia Soledad Vegega, Dr. Florencia Pollo Cattaneo
Group project with: Nicolas Agustin Molina, Romina Giselle Velasco - November 2024

An Artificial Intelligence project applying classical knowledge-based systems methodology — knowledge acquisition, taxonomy construction, ontology design (METHONTOLOGY), rule-based inference, and fuzzy logic to reduce false positives in bug report triage for an e-commerce platform.

Objective: Determine which real failures correspond to actual software/application malfunctions in a supermarket e-commerce platform, as opposed to issues caused by the user's device configuration.

I contributed as the domain expert consulted during the knowledge acquisition process, drawing on real-world QA/e-commerce troubleshooting experience, and collaborated on the taxonomy, ontology, and rule definitions with my teammates.

All case scenarios presented are fictional and illustrative (not real client data).`,
            githubUrl: "https://github.com/agustindiazcano/fuzzy-logic-expert-system-qa-triage"
        }
    ];

    return publications.map((pub) => ({
        params: { slug: pub.slug },
        props: { pub },
    }));
}

const { pub } = Astro.props;
---

<Layout 
  title={`${pub.title} | Agustin Diaz-Cano Research`}
  description={`${pub.description} — A research project by Agustin Diaz-Cano.`}
>
    <main class="min-h-screen max-w-[1000px] mx-auto px-6 pb-20 pt-12">

        <div class="mb-8">
            <a
                href="/research"
                class="text-[#666] hover:text-white transition-colors text-sm inline-flex items-center gap-1"
                >← Back to Research</a
            >
        </div>

        <header class="mb-12">
            <h1 class="text-3xl md:text-5xl font-bold tracking-tight text-white mb-6 leading-tight">
                {pub.title}
            </h1>
            
            <p class="text-xl text-[#888] font-light leading-relaxed mb-8">
                {pub.description}
            </p>

            {pub.githubUrl && (
                <div class="flex gap-4">
                    <a href={pub.githubUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 bg-[#111] hover:bg-[#222] border border-[#333] text-white px-6 py-3 rounded-xl transition-all font-medium text-sm">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
                        View Repository
                    </a>
                </div>
            )}
        </header>

        <div class="w-full h-[1px] bg-gradient-to-r from-transparent via-[#333] to-transparent mb-12"></div>

        <article class="prose prose-invert prose-p:text-[#aaa] prose-headings:text-white max-w-none">
            <div class="bg-[#111] border border-[#222] p-8 rounded-2xl whitespace-pre-wrap leading-relaxed text-sm md:text-base text-[#ccc]">
                {pub.content}
            </div>
        </article>

    </main>

    <Footer />
</Layout>
