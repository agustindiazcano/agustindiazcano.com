---
import Layout from "../layouts/Layout.astro";
import PageNav from "../components/PageNav.astro";
import Footer from "../components/Footer.astro";
import CSSBlackHole from "../components/CSSBlackHole.astro";
import RankingTierList from "../components/RankingTierList.astro";
import { competitionTiers, competitionsLastUpdated } from "../data/competitions";

const siteUrl = "https://www.agustindiazcano.com";
const pageUrl = `${siteUrl}/competitions`;
const title = "Competitions and Hackathons | Agustin Diaz-Cano";
const description =
    "Hackathons and competitions entered by Agustin Diaz-Cano, Software Engineer, with results and links to the official sources.";

const schema = {
    "@context": "https://schema.org",
    "@graph": [
        {
            "@type": "CollectionPage",
            "@id": `${pageUrl}#page`,
            url: pageUrl,
            name: title,
            description,
            inLanguage: "en",
            dateModified: competitionsLastUpdated,
            isPartOf: { "@type": "WebSite", url: siteUrl },
            about: { "@type": "Person", name: "Agustin Diaz-Cano", url: siteUrl },
            mainEntity: { "@id": `${pageUrl}#list` },
        },
        {
            "@type": "ItemList",
            "@id": `${pageUrl}#list`,
            itemListElement: competitionTiers
                .flatMap((tier) => tier.entries)
                .map((entry, index) => ({
                    "@type": "ListItem",
                    position: index + 1,
                    name: `${entry.platform}: ${entry.metric}`,
                    url: entry.url,
                })),
        },
        {
            "@type": "BreadcrumbList",
            itemListElement: [
                { "@type": "ListItem", position: 1, name: "Home", item: siteUrl },
                { "@type": "ListItem", position: 2, name: "Competitions", item: pageUrl },
            ],
        },
    ],
};
---

<Layout title={title} description={description} canonicalUrl={pageUrl}>
    <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, "\\u003c")} />
    <CSSBlackHole />
    <main class="page-fade-in min-h-screen max-w-[800px] mx-auto px-6 pb-20 relative z-10">
        <PageNav items={[{ label: "Competitions" }]} backHref="/" />
        <header class="mb-12">
            <h1 class="text-3xl md:text-4xl font-bold tracking-tight text-white mb-3">Competitions</h1>
            <p class="text-[#888] leading-relaxed">
                Hackathons and competitions I have entered. Every row links to its original source.
            </p>
            <p class="font-mono text-[11px] text-[#555] mt-3">
                Last updated <time datetime={competitionsLastUpdated}>{competitionsLastUpdated}</time>.
            </p>
        </header>

        <div class="space-y-12">
            {competitionTiers.map((tier) => <RankingTierList tier={tier} />)}
        </div>

        <p class="mt-12 text-sm text-[#666]">
            See also <a href="/rankings" class="text-[#888] underline underline-offset-4 hover:text-white transition-colors">rankings and recognition</a>.
        </p>

        <div class="mt-20">
            <Footer />
        </div>
    </main>
</Layout>
