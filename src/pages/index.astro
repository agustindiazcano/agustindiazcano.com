---
import Layout from "../layouts/Layout.astro";
import { featured } from "../data/featured";
import { news } from "../data/news";
import { highlights } from "../data/highlights";
import { posts } from "../data/blog";
import { projects } from "../data/projects";
import Footer from "../components/Footer.astro";
import ClaudeUsage from "../components/ClaudeUsage.astro";
import GargantuaBackground from "../components/GargantuaBackground.astro";
import LoadingScreen from "../components/LoadingScreen.astro";
---

<Layout 
    title="Agustin Diaz-Cano | Software Engineer | AI/ML & Backend | MS Candidate, Systems Engineering"
    description="Agustin Diaz-Cano is a Software Engineer and MS Candidate, Systems Engineering specializing in backend, AI/ML, and systems engineering."
>
    <LoadingScreen />
    <GargantuaBackground isHome={true} />
    {/* Floats to the right of the header from 1024px up (compact below 1300px), stacks above the grid otherwise */}
    <div id="home-floating-usage" class="w-full max-w-[1200px] mx-auto px-6 mb-0 flex flex-col items-start gap-1.5 relative z-20">
        <ClaudeUsage />
    </div>
    <main
        id="home-main-content"
        class="min-h-screen flex flex-col items-center justify-start max-w-[1200px] mx-auto px-6 pb-20 relative z-10 opacity-0 translate-y-6 transition-all duration-1000 ease-out"
    >

        {/* Hero */}
        <div class="w-full grid grid-cols-1 min-[1100px]:grid-cols-[minmax(0,1fr)_15rem] gap-4 mt-0 mb-10 md:mb-16">
        <section class="glass-panel usage-attached grid grid-cols-1 md:grid-cols-[12rem_minmax(0,1fr)] gap-8 md:gap-10 p-6 md:p-10">
            <div class="flex flex-row md:flex-col items-center md:items-start justify-center md:justify-start gap-9 md:gap-5">
                <div class="w-32 h-32 md:w-48 md:h-48 rounded-[var(--glass-radius)] bg-[#111] border border-white/10 overflow-hidden grayscale hover:grayscale-0 transition-all duration-700 shadow-[0_10px_30px_rgba(0,0,0,0.5),inset_0_1px_0_rgba(255,255,255,0.12)]">
                    <img
                        src="/images/agustin-diaz-cano-software-engineer-1.png"
                        alt="Agustin Diaz-Cano"
                        loading="lazy"
                        class="w-full h-full object-cover"
                    />
                </div>
                <div class="flex flex-col md:flex-row items-center gap-4 md:gap-6 text-[#888]">
                    <a href="https://github.com/agustindiazcano" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors" aria-label="GitHub">
                        <svg class="w-8 h-8 md:w-6 md:h-6" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
                    </a>
                    <a href="https://linkedin.com/in/agustindiazcano" target="_blank" rel="noopener noreferrer" class="hover:text-[#0077b5] transition-colors" aria-label="LinkedIn">
                        <svg class="w-8 h-8 md:w-6 md:h-6" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/></svg>
                    </a>
                    <a href="mailto:agusdiazcano@gmail.com" class="hover:text-[#ea4335] transition-colors" aria-label="Email">
                        <svg class="w-8 h-8 md:w-6 md:h-6" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
                    </a>
                </div>
            </div>
            <div class="min-w-0 flex flex-col justify-center text-center md:text-left">
                <h2 class="hidden md:block font-display text-3xl md:text-[2.875rem] md:leading-tight font-medium text-white tracking-tight mb-5">Agustin Diaz-Cano</h2>
                <p class="text-[#aaa] leading-relaxed mb-4">
                    MS Candidate, Systems Engineering, at <a href="https://frba.utn.edu.ar/" target="_blank" rel="noopener noreferrer" class="text-white underline decoration-white/30 underline-offset-4 hover:decoration-white transition-colors duration-500">UTN</a>, focused on AI and full stack development.
                </p>
                <p id="hero-bio" class="hero-bio is-collapsed text-[#888] leading-relaxed">
                    6+ years building software and 4+ years shipping production systems across 10+ large-scale platforms used by hundreds of thousands of users across Europe and Latin America.
                </p>
                {/* Mobile only: the long paragraph is collapsed and toggled */}
                <button
                    id="hero-bio-toggle"
                    type="button"
                    class="md:hidden mt-3 self-center text-sm text-white/80 hover:text-white underline decoration-white/30 underline-offset-4 transition-colors duration-500 cursor-pointer"
                    aria-expanded="false"
                    aria-controls="hero-bio"
                >Read more</button>
            </div>
        </section>

        {/* Right container: quick buttons to the sections of this page */}
        <aside class="glass-panel p-5 flex flex-col gap-3" aria-label="Sections of this page">
            <span class="font-mono text-[10px] uppercase tracking-wider text-[#888]">Sections</span>
            <nav class="flex flex-row flex-wrap min-[1100px]:flex-col gap-2">
                {[
                    ["Featured Projects", "#featured"],
                    ["Highlights", "#highlights"],
                    ["News", "#news"],
                    ["Blog", "#blog"],
                    ["Projects", "#projects"],
                ].map(([label, href]) => (
                    <a href={href} class="section-btn">
                        <span>{label}</span>
                        <span aria-hidden="true">&darr;</span>
                    </a>
                ))}
            </nav>
        </aside>
        </div>

        {/* Featured carousel */}
        <section class="w-full mb-16 md:mb-24 scroll-mt-6" id="featured" aria-labelledby="featured-title">
            <div class="flex items-baseline justify-between mb-5">
                <h2 id="featured-title" class="font-display text-2xl text-white font-medium">Featured Projects</h2>
                <a href="/projects" class="text-sm text-[#888] hover:text-white transition-colors">All projects</a>
            </div>
            <div class="relative group/carousel" id="featured-carousel">
                <button type="button" data-dir="-1" aria-label="Previous featured" class="featured-arrow absolute left-2 top-1/2 -translate-y-1/2 z-20 w-10 h-10 rounded-full bg-black/70 border border-[#333] text-white flex items-center justify-center cursor-pointer backdrop-blur-sm hover:bg-black hover:border-[#666] transition-all disabled:opacity-0 disabled:pointer-events-none">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
                </button>
                <div data-track class="featured-track flex gap-4 overflow-x-auto snap-x snap-mandatory scroll-smooth">
                    {featured.map((item) => (
                        <a
                            href={item.href}
                            class="featured-card group relative shrink-0 snap-start aspect-[316/200] w-[calc((100%-1rem)/2)] md:w-[calc((100%-2rem)/3)] lg:w-[calc((100%-3rem)/4)] rounded-xl overflow-hidden border border-[#222] bg-[#111] hover:border-[#444] transition-colors"
                        >
                            <img src={item.image} alt={item.title} loading="lazy" class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />
                            <div class="absolute inset-0 bg-gradient-to-t from-black/95 via-black/55 to-transparent"></div>
                            <div class="absolute bottom-0 left-0 right-0 p-4">
                                <span class="block text-[10px] font-mono uppercase tracking-wider text-[#999] mb-1">{item.label}</span>
                                <span class="block text-xs md:text-sm lg:text-base font-medium text-white leading-snug">{item.title}</span>
                            </div>
                        </a>
                    ))}
                </div>
                <button type="button" data-dir="1" aria-label="Next featured" class="featured-arrow absolute right-2 top-1/2 -translate-y-1/2 z-20 w-10 h-10 rounded-full bg-black/70 border border-[#333] text-white flex items-center justify-center cursor-pointer backdrop-blur-sm hover:bg-black hover:border-[#666] transition-all disabled:opacity-0 disabled:pointer-events-none">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
                </button>
            </div>
            <div class="flex justify-center gap-2 mt-5" id="featured-dots" role="tablist" aria-label="Featured position">
                {featured.map((item, i) => (
                    <button
                        type="button"
                        data-dot={i}
                        aria-label={`Go to ${item.title}`}
                        class="featured-dot h-2 w-2 rounded-full bg-[#333] hover:bg-[#666] cursor-pointer transition-all duration-300"
                    ></button>
                ))}
            </div>
        </section>

        {/* Highlights */}
        <section class="w-full mb-16 scroll-mt-6" id="highlights" aria-labelledby="highlights-title">
            <div class="flex items-baseline justify-between mb-5">
                <h2 id="highlights-title" class="font-display text-2xl text-white font-medium">Highlights</h2>
                <a href="/rankings" class="text-sm text-[#888] hover:text-white transition-colors">View all</a>
            </div>
            <ul class="glass-panel divide-y divide-white/10 px-4 md:px-6 py-1">
                {highlights.map((item) => (
                    <li>
                        <a href={item.href} class="flex items-baseline gap-4 py-3 group">
                            <span class="shrink-0 w-12 md:w-[6.5rem] text-xs font-mono text-[#efd98a]">{item.year}</span>
                            <span class="min-w-0 flex-1 md:flex md:flex-wrap md:items-baseline md:gap-x-3 text-sm md:text-base">
                                <span class="block md:inline text-[#ccc] group-hover:text-white transition-colors duration-500">{item.title}</span>
                                <span aria-hidden="true" class="hidden md:inline text-[#555]">&#9474;</span>
                                <span class="block md:inline text-[#888] group-hover:text-[#ccc] transition-colors duration-500">{item.result}</span>
                            </span>
                        </a>
                    </li>
                ))}
            </ul>
        </section>

        {/* News */}
        <section class="w-full mb-16 scroll-mt-6" id="news" aria-labelledby="news-title">
            <div class="flex items-baseline justify-between mb-5">
                <h2 id="news-title" class="font-display text-2xl text-white font-medium">News</h2>
                <a href="/news" class="text-sm text-[#888] hover:text-white transition-colors">View all</a>
            </div>
            <ul class="glass-panel divide-y divide-white/10 px-4 md:px-6 py-1">
                {news.slice(0, 5).map((item) => (
                    <li>
                        {item.href ? (
                            <a href={item.href} class="flex items-baseline gap-4 py-3 group">
                                <span class="shrink-0 w-20 text-xs font-mono text-[#efd98a]">{item.date}</span>
                                <span class="min-w-0 flex-1 truncate text-sm md:text-base text-[#ccc] group-hover:text-white transition-colors">{item.title}</span>
                            </a>
                        ) : (
                            <div class="flex items-baseline gap-4 py-3">
                                <span class="shrink-0 w-20 text-xs font-mono text-[#efd98a]">{item.date}</span>
                                <span class="min-w-0 flex-1 truncate text-sm md:text-base text-[#ccc]">{item.title}</span>
                            </div>
                        )}
                    </li>
                ))}
            </ul>
        </section>

        {/* Blog */}
        <section class="w-full mb-16 scroll-mt-6" id="blog" aria-labelledby="blog-title">
            <div class="flex items-baseline justify-between mb-5">
                <h2 id="blog-title" class="font-display text-2xl text-white font-medium">Blog</h2>
                <a href="/writing" class="text-sm text-[#888] hover:text-white transition-colors">View all</a>
            </div>
            <ul class="glass-panel divide-y divide-white/10 px-4 md:px-6 py-1">
                {posts.slice(0, 5).map((post) => (
                    <li>
                        <a href={`/writing/${post.slug}`} class="flex items-baseline gap-4 py-3 group">
                            <span class="shrink-0 w-20 text-xs font-mono text-[#efd98a]">{post.date}</span>
                            <span class="min-w-0 flex-1 truncate text-sm md:text-base text-[#ccc] group-hover:text-white transition-colors">{post.title}</span>
                        </a>
                    </li>
                ))}
            </ul>
        </section>

        {/* Projects */}
        <section class="w-full mb-16 scroll-mt-6" id="projects" aria-labelledby="projects-title">
            <div class="flex items-baseline justify-between mb-5">
                <h2 id="projects-title" class="font-display text-2xl text-white font-medium">Projects</h2>
                <a href="/projects" class="text-sm text-[#888] hover:text-white transition-colors">View all</a>
            </div>
            <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
                {projects.slice(0, 8).map((project) => (
                    <a
                        href={`/projects/${project.slug}`}
                        class="group relative aspect-[316/200] rounded-xl overflow-hidden border border-[#222] bg-[#111] hover:border-[#444] transition-colors"
                    >
                        {project.image ? (
                            <img src={project.image} alt={project.title} loading="lazy" class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />
                        ) : (
                            <div class="absolute inset-0 bg-[url('/grid-pattern.svg')] bg-[#111] opacity-60"></div>
                        )}
                        <div class="absolute inset-0 bg-gradient-to-t from-black/95 via-black/55 to-transparent"></div>
                        <div class="absolute bottom-0 left-0 right-0 p-4">
                            <span class="block text-xs md:text-sm lg:text-base font-medium text-white leading-snug line-clamp-3">{project.title}</span>
                        </div>
                    </a>
                ))}
            </div>
        </section>

        <Footer isHome={true} />

        <script>
            function setupFeaturedCarousel() {
                const root = document.getElementById('featured-carousel');
                if (!root || root.dataset.bound) return;
                root.dataset.bound = 'true';
                const track = root.querySelector<HTMLElement>('[data-track]');
                const prev = root.querySelector<HTMLButtonElement>('[data-dir="-1"]');
                const next = root.querySelector<HTMLButtonElement>('[data-dir="1"]');
                if (!track || !prev || !next) return;

                const cards = Array.from(track.querySelectorAll<HTMLElement>('.featured-card'));
                const dots = Array.from(document.querySelectorAll<HTMLButtonElement>('#featured-dots [data-dot]'));
                const update = () => {
                    prev.disabled = track.scrollLeft <= 4;
                    next.disabled = track.scrollLeft + track.clientWidth >= track.scrollWidth - 4;
                    // Light up the dots of the cards currently in view
                    const box = track.getBoundingClientRect();
                    cards.forEach((card, i) => {
                        const r = card.getBoundingClientRect();
                        const visible = r.left >= box.left - 8 && r.right <= box.right + 8;
                        dots[i]?.classList.toggle('is-active', visible);
                    });
                };
                dots.forEach((dot, i) => {
                    dot.addEventListener('click', () => {
                        const target = cards[i];
                        if (!target) return;
                        const left = target.getBoundingClientRect().left - track.getBoundingClientRect().left + track.scrollLeft;
                        track.scrollTo({ left, behavior: 'smooth' });
                    });
                });
                const step = () => {
                    const card = track.querySelector<HTMLElement>('.featured-card');
                    return card ? card.offsetWidth + 16 : track.clientWidth;
                };
                prev.addEventListener('click', () => track.scrollBy({ left: -step(), behavior: 'smooth' }));
                next.addEventListener('click', () => track.scrollBy({ left: step(), behavior: 'smooth' }));
                track.addEventListener('scroll', update, { passive: true });
                window.addEventListener('resize', update);
                update();
            }
            document.addEventListener('astro:page-load', setupFeaturedCarousel);
            function setupHeroBio() {
                const bio = document.getElementById('hero-bio');
                const btn = document.getElementById('hero-bio-toggle');
                if (!bio || !btn || btn.dataset.bound) return;
                btn.dataset.bound = 'true';
                btn.addEventListener('click', () => {
                    const collapsed = bio.classList.toggle('is-collapsed');
                    btn.textContent = collapsed ? 'Read more' : 'Show less';
                    btn.setAttribute('aria-expanded', String(!collapsed));
                });
            }
            document.addEventListener('astro:page-load', setupHeroBio);

        </script>

        <style>
            /* Profile hero: same glass as the AI usage bar attached on top (same tone, blur, border and shadow) */
            .glass-panel {
                position: relative;
                border-radius: var(--glass-radius);
                background:
                    linear-gradient(145deg, rgba(255, 255, 255, 0.07), rgba(255, 255, 255, 0.015) 50%, rgba(255, 255, 255, 0.035)),
                    rgba(8, 8, 10, 0.78);
                -webkit-backdrop-filter: blur(16px) saturate(170%);
                backdrop-filter: blur(16px) saturate(170%);
                border: 1px solid rgba(255, 255, 255, 0.1);
                box-shadow:
                    inset 0 1px 0 rgba(255, 255, 255, 0.18),
                    inset 0 -1px 0 rgba(0, 0, 0, 0.45),
                    -3px -3px 10px rgba(255, 255, 255, 0.02),
                    6px 8px 18px rgba(0, 0, 0, 0.5);
            }
            .glass-panel > * {
                position: relative;
                z-index: 1;
            }
            @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
                .glass-panel {
                    background: rgba(8, 8, 10, 0.94);
                }
            }
            /* The AI usage bar sits on top of this card like a joined tab: square the corner under it */
            .glass-panel.usage-attached {
                border-top-left-radius: 0;
            }
            /* Mobile: the bar spans the full card width, so the top-right corner is joined too */
            @media (max-width: 767px) {
                .glass-panel.usage-attached {
                    border-top-right-radius: 0;
                }
            }
            /* Mobile: collapse the long paragraph to 3 lines until toggled */
            @media (max-width: 767px) {
                .hero-bio.is-collapsed {
                    display: -webkit-box;
                    -webkit-line-clamp: 3;
                    -webkit-box-orient: vertical;
                    overflow: hidden;
                }
            }
            /* Section buttons in the right hero container */
            .section-btn {
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 0.75rem;
                padding: 0.6rem 0.85rem;
                font-size: 0.875rem;
                color: #b5b5b5;
                border-radius: var(--glass-radius);
                background-image: linear-gradient(145deg, rgba(255, 255, 255, 0.07), rgba(255, 255, 255, 0.015) 50%, rgba(255, 255, 255, 0.035));
                background-color: rgba(8, 8, 10, 0.78);
                border: 1px solid rgba(255, 255, 255, 0.1);
                box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.18), inset 0 -1px 0 rgba(0, 0, 0, 0.45), 6px 8px 18px rgba(0, 0, 0, 0.5);
                transition: color 0.5s ease, background-color 0.5s ease, border-color 0.5s ease, box-shadow 0.5s ease;
            }
            .section-btn:hover,
            .section-btn:focus-visible {
                color: #ffffff;
                background-color: rgba(52, 52, 60, 0.7);
                border-color: rgba(255, 255, 255, 0.22);
                box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.26), inset 0 -1px 0 rgba(0, 0, 0, 0.45), 8px 12px 22px rgba(0, 0, 0, 0.55), 0 0 18px rgba(239, 217, 138, 0.3);
            }
            .featured-track {
                scrollbar-width: none;
                -ms-overflow-style: none;
            }
            .featured-track::-webkit-scrollbar {
                display: none;
            }
            .featured-dot.is-active {
                background-color: #efd98a;
                width: 1.25rem;
            }
            .fade-in {
                animation: fadeIn 1s ease-out forwards;
                opacity: 0;
            }
            @keyframes fadeIn {
                from {
                    opacity: 0;
                    transform: translateY(20px);
                }
                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }
            /* Not !important on purpose: an !important value would override the intro reveal animation and cause a pop-in */
            #home-main-content.show {
                opacity: 1;
                transform: none;
                /* Tailwind v4 translate-y-* uses the "translate" property, which "transform: none" does not reset */
                translate: none;
            }
            :global(.skip-loading-screen) #home-main-content {
                animation: pageContentFadeIn 0.55s cubic-bezier(0.16, 1, 0.3, 1) forwards;
            }
            :global(html.rabbit-cinema-active) #home-main-content,
            :global(html.rabbit-cinema-active.skip-loading-screen) #home-main-content,
            :global(html.rabbit-cinema-active) #home-main-content.show,
            :global(html.rabbit-cinema-active) #home-floating-usage {
                opacity: 0 !important;
                visibility: hidden !important;
                pointer-events: none !important;
                transform: translateY(16px) scale(0.98) !important;
                transition: opacity 0.45s ease, visibility 0.45s !important;
                animation: none !important;
            }
        </style>
    </main>
</Layout>
