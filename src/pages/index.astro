---
import Layout from "../layouts/Layout.astro";
import ProjectGrid from "../components/ProjectGrid.jsx";
import Footer from "../components/Footer.astro";
import ClaudeUsage from "../components/ClaudeUsage.astro";
import GargantuaBackground from "../components/GargantuaBackground.astro";
import LoadingScreen from "../components/LoadingScreen.astro";
---

<Layout 
    title="Agustin Diaz-Cano | Software Engineer | AI/ML & Backend | MS Candidate, Systems Engineering"
    description="Agustin Diaz-Cano is a Software Engineer and MS Candidate, Systems Engineering specializing in backend, AI/ML, and systems engineering."
>
    <LoadingScreen />
    <GargantuaBackground isHome={true} />
    {/* Floats to the right of the header from 1024px up (compact below 1300px), stacks above the grid otherwise */}
    <div id="home-floating-usage" class="w-full max-w-[1200px] mx-auto px-6 mb-3 flex flex-col items-end gap-1.5 relative z-20 lg:absolute lg:top-2 lg:right-6 lg:w-auto lg:max-w-none lg:mx-0 lg:px-0 lg:mb-0 transition-all duration-700">
        <ClaudeUsage />
        <a href="/agents-usage" class="hidden md:flex md:w-48 min-[1300px]:w-64 items-center justify-between rounded-md md:rounded-lg border border-[#292929] bg-[#111] px-3 py-1.5 md:px-4 md:py-2.5 text-[10px] md:text-xs font-mono text-[#aaa] transition-colors hover:border-[#68d6ba] hover:text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-[#68d6ba]">AI Usage <span aria-hidden="true">↗</span></a>
    </div>
    <main
        id="home-main-content"
        class="min-h-screen flex flex-col items-center justify-start max-w-[1200px] mx-auto px-6 pb-20 relative z-10 opacity-0 translate-y-6 transition-all duration-1000 ease-out"
    >

        {/* Bento Grid (Interactive) */}
        <ProjectGrid client:load />

        <Footer isHome={true} />

        <style>
            .fade-in {
                animation: fadeIn 1s ease-out forwards;
                opacity: 0;
            }
            @keyframes fadeIn {
                from {
                    opacity: 0;
                    transform: translateY(20px);
                }
                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }
            #home-main-content.show {
                opacity: 1 !important;
                transform: none !important;
            }
            :global(.skip-loading-screen) #home-main-content {
                opacity: 1 !important;
                transform: none !important;
                transition: none !important;
            }
            :global(html.rabbit-cinema-active) #home-main-content,
            :global(html.rabbit-cinema-active.skip-loading-screen) #home-main-content,
            :global(html.rabbit-cinema-active) #home-main-content.show,
            :global(html.rabbit-cinema-active) #home-floating-usage {
                opacity: 0 !important;
                visibility: hidden !important;
                pointer-events: none !important;
                transform: translateY(16px) scale(0.98) !important;
                transition: opacity 0.45s ease, visibility 0.45s !important;
            }
        </style>
    </main>
</Layout>
