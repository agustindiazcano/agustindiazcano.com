---
import Layout from "../layouts/Layout.astro";
import ProjectGrid from "../components/ProjectGrid.jsx";
import Footer from "../components/Footer.astro";
---

<Layout 
    title="Agustin Diaz-Cano | Software Engineer — AI/ML & Backend"
    description="Agustin Diaz-Cano is a Software Engineer and MSc Candidate specializing in backend, AI/ML, and systems engineering."
>
    <main
        class="min-h-screen flex flex-col items-center justify-start max-w-[1200px] mx-auto px-6 pb-20"
    >

        {/* Bento Grid (Interactive) */}
        <ProjectGrid client:load />

        <Footer />

        <style>
            .fade-in {
                animation: fadeIn 1s ease-out forwards;
                opacity: 0;
            }
            @keyframes fadeIn {
                from {
                    opacity: 0;
                    transform: translateY(20px);
                }
                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }
        </style>
    </main>
</Layout>
