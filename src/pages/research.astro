---
import Layout from "../layouts/Layout.astro";
import Footer from "../components/Footer.astro";
import CSSBlackHole from "../components/CSSBlackHole.astro";

const publications = [
    {
        title: "Artificial Intelligence Based Bug Triage System",
        slug: "bug-triage-system",
        description: "An Artificial Intelligence project applying classical knowledge-based systems methodology and fuzzy logic to reduce false positives in bug report triage.",
        date: "Nov 2024"
    }
];
---

<Layout 
  title="Research | Agustin Diaz-Cano"
  description="Academic research, publications, and scientific work by Agustin Diaz-Cano."
>
  <CSSBlackHole />
  <main class="min-h-screen max-w-[800px] mx-auto px-6 pb-20 relative z-10">

    <section class="mb-16 flex flex-col md:flex-row justify-between items-center md:items-start gap-8 text-center md:text-left">
      <div class="flex flex-col items-center md:items-start w-full md:w-auto">
        <h2 class="text-3xl font-bold tracking-tight text-white mb-3 text-center md:text-left">Research</h2>
        <p class="text-[#888] mb-8 text-center md:text-left">
          Publications and Academic Work
        </p>

        <a href="https://frba.utn.edu.ar/" target="_blank" rel="noopener noreferrer" class="flex items-center justify-center md:justify-start gap-2 text-[#888] hover:text-white transition-colors group">
          <img src="/images/utn-logo-2.png" alt="Agustin Diaz-Cano - University Logo" loading="lazy" class="w-5 h-5 rounded-sm object-cover bg-[#222] border border-[#333] group-hover:border-[#555] transition-colors" />
          <span class="text-sm font-medium">Universidad Tecnológica Nacional</span>
        </a>
      </div>

      <div class="flex flex-col items-center md:items-start gap-3 min-w-[150px] w-full md:w-auto">
        <!-- Google Scholar -->
        <a href="https://scholar.google.com/citations?user=qUcRD6UAAAAJ&hl=en" target="_blank" rel="noopener noreferrer" class="flex items-center justify-center md:justify-start gap-2 text-[#888] hover:text-blue-400 transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
          <span class="text-sm font-medium">Google Scholar</span>
        </a>

        <!-- ResearchGate -->
        <a href="https://www.researchgate.net/profile/Agustin-Diaz-Cano" target="_blank" rel="noopener noreferrer" class="flex items-center justify-center md:justify-start gap-2 text-[#888] hover:text-[#00ccbb] transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 2v7.31"/><path d="M14 9.3V1.99"/><path d="M8.5 2h7"/><path d="M14 9.3a6.5 6.5 0 1 1-4 0"/><path d="M5.52 16h12.96"/></svg>
          <span class="text-sm font-medium">ResearchGate</span>
        </a>

        <!-- ORCID -->
        <a href="https://orcid.org/0009-0001-4336-490X" target="_blank" rel="noopener noreferrer" class="flex items-center justify-center md:justify-start gap-2 text-[#888] hover:text-[#a6ce39] transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="14" x="3" y="5" rx="2" ry="2"/><path d="M7 15h4"/><path d="M7 11h.01"/><path d="M13 11h4"/><path d="M13 15h4"/></svg>
          <span class="text-sm font-medium">ORCID</span>
        </a>
      </div>
    </section>

    <div class="space-y-12">
      {
        publications.length > 0 ? publications.map((pub) => (
          <article class="group relative">
            <div class="flex justify-between items-baseline mb-2">
              <h2 class="text-xl font-semibold text-white group-hover:text-blue-400 transition-colors">
                <a
                  href={`/research/${pub.slug}`}
                  class="absolute inset-0 z-10 focus:outline-none"
                >
                  <span class="sr-only">Read - {pub.title}</span>
                </a>
                {pub.title}
              </h2>
              <span class="text-sm font-mono text-[#444]">{pub.date}</span>
            </div>
            <p class="text-[#666] text-sm leading-relaxed relative z-20 pointer-events-none">
              {pub.description}
            </p>
          </article>
        )) : (
          <p class="text-[#666] italic">Academic publications will be listed here soon.</p>
        )
      }
    </div>
    <div class="mt-20">
      <Footer />
    </div>
  </main>
</Layout>
