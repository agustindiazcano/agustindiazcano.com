---
import Layout from "../layouts/Layout.astro";
import Footer from "../components/Footer.astro";
import CSSBlackHole from "../components/CSSBlackHole.astro";

const repos = [
    {
        name: "Agentic MCP Engine and RAG Gateway",
        description: "AI-driven transactional agent using Model Context Protocol.",
        url: "https://github.com/agustindiazcano/mcp-transactional-agent",
        category: "AI & Agents"
    },
    {
        name: "Algorithmic Trading Engine",
        description: "Automated trading system for financial markets.",
        url: "https://github.com/agustindiazcano/algorithmic-trading-engine",
        category: "Fintech"
    },
    {
        name: "OpenAI LLM Optimizers - Parameter Golf",
        description: "Optimization techniques for LLM parameters.",
        url: "https://github.com/agustindiazcano/openai-llm-optimizers-parameter-golf",
        category: "Machine Learning"
    },
    {
        name: "Fuzzy Logic Expert System - QA Triage",
        description: "Expert system for automated QA issue triage using fuzzy logic.",
        url: "https://github.com/agustindiazcano/fuzzy-logic-expert-system-qa-triage",
        category: "AI Systems"
    },
    {
        name: "Portfolio",
        description: "Personal website and interactive web portfolio.",
        url: "https://github.com/agustindiazcano/agustindiazcano.com",
        category: "Web Frontend"
    },
    {
        name: "ETH Mining Infrastructure 2017",
        description: "Infrastructure and scripts for Ethereum mining operations.",
        url: "https://github.com/agustindiazcano/eth-mining-infrastructure-2017",
        category: "Crypto & Infrastructure"
    }
];
---

<Layout title="GitHub Repositories - Agustin Diaz-Cano">
    <CSSBlackHole />
    <main class="w-full flex justify-center pt-0 pb-20 px-4 min-h-[80vh] relative z-10">
        <div class="max-w-3xl w-full flex flex-col gap-8">
            
            <div class="space-y-4">
                <div class="flex justify-between items-center mb-6">
                    <h2 class="text-[1.4rem] text-white tracking-wider">
                        Featured Repositories
                    </h2>
                    <a
                        href="https://github.com/agustindiazcano"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center justify-center gap-2 px-4 py-2 bg-white text-black text-sm font-medium rounded-full hover:bg-gray-200 hover:scale-[1.02] active:scale-95 transition-all shadow-[0_0_20px_rgba(255,255,255,0.1)]"
                    >
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
                        Visit My GitHub Profile
                    </a>
                </div>
                
                <div class="flex flex-col gap-4 items-center">
                    {repos.map(repo => (
                        <a 
                            href={repo.url} 
                            target="_blank" 
                            rel="noopener noreferrer" 
                            class="group relative flex flex-col justify-center w-full max-w-[48rem] h-[6rem] p-6 rounded-2xl border border-[#222] bg-[#111] hover:bg-[#1a1a1a] hover:border-[#444] transition-all duration-300 overflow-hidden"
                        >
                            <div class="absolute inset-0 bg-white/5 opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none" />
                            
                            <div class="relative z-10 flex flex-col h-full gap-3">
                                <div class="flex justify-between items-start gap-4">
                                    <h3 class="font-display text-xl font-medium text-white group-hover:text-blue-400 transition-colors leading-tight">
                                        {repo.name}
                                    </h3>
                                    <svg class="text-[#555] group-hover:text-blue-400 transition-colors shrink-0" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                                </div>
                                
                                <p class="text-[#888] text-sm leading-relaxed mb-4">
                                    {repo.description}
                                </p>
                                
                                <div class="mt-auto flex items-center">
                                    <span class="text-[11px] font-mono text-[#666] uppercase tracking-wider border border-[#333] px-2 py-1 rounded-md bg-[#0a0a0a]">
                                        {repo.category}
                                    </span>
                                </div>
                            </div>
                        </a>
                    ))}
                </div>
            </div>

            <Footer />
        </div>
    </main>
</Layout>
