---
import Layout from "../layouts/Layout.astro";
import PageNav from "../components/PageNav.astro";
import Footer from "../components/Footer.astro";
import CSSBlackHole from "../components/CSSBlackHole.astro";

import { posts } from "../data/blog";
---

<Layout 
  title="Blog | Agustin Diaz-Cano"
  description="Technical notes, articles, and research on systems engineering, performance, and quantitative finance written by Agustin Diaz-Cano."
>
  <CSSBlackHole />
  <main class="page-fade-in min-h-screen max-w-[800px] mx-auto px-6 pb-20 relative z-10">
        <PageNav items={[{ label: "Blog" }]} backHref="/" />

    <section class="mb-8 md:mb-12">
      <h2 class="text-3xl font-bold tracking-tight text-white mb-3 text-center md:text-left">Blog</h2>
      <p class="text-[#888] text-center md:text-left">
        Opinion
      </p>
    </section>

    <div class="space-y-6">
      {
        posts.map((post) => (
          <article class="group relative bg-black/90 backdrop-blur-sm border border-[#222] rounded-2xl p-6 hover:bg-black hover:border-[#444] transition-all duration-300">
            <div class="flex justify-between items-baseline mb-2">
              <h2 class="text-xl font-semibold text-white group-hover:text-blue-400 transition-colors">
                <a
                  href={`/writing/${post.slug}`}
                  class="absolute inset-0 z-10 focus:outline-none"
                >
                  <span class="sr-only">Read - {post.title}</span>
                </a>
                {post.title}
              </h2>
              <span class="text-sm font-mono text-[#444]">{post.date}</span>
            </div>
            <p class="text-[#666] text-sm leading-relaxed relative z-20 pointer-events-none">
              {post.description}
            </p>
          </article>
        ))
      }
    </div>
    <div class="mt-20">
      <Footer />
    </div>
  </main>
</Layout>
