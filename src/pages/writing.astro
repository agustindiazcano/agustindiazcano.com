---
import Layout from "../layouts/Layout.astro";
import Footer from "../components/Footer.astro";

const posts = [
  {
    slug: "fundamental-principles",
    title: "Fundamental Principles of Scientific Validation",
    date: "Mar 3, 2026",
    description:
      "If you cannot describe the physical or logical mechanism driving the inner workings of a phenomenon, you do not have a theory, you have a statistical anecdote.",
  },
  {
    slug: "predicting-generative-ai-boom",
    title: "Predicting the Generative AI Boom: My Tech Presentation in March 2021",
    date: "Mar 2021",
    description:
      "A timestamped, verifiable record of live engagement with generative AI technology and accurate forecasting of its trajectory, 20 months before ChatGPT.",
  },
  {
    slug: "gdu-testing-architecture", // Matches [slug].astro
    title: "lorem",
    date: "2024",
    description:
      "Designing a high-throughput testing framework for retail transaction systems.",
  },
  {
    slug: "genetic-algorithms-python",
    title: "Genetic Algorithms in Python",
    date: "2025",
    description:
      "lorem",
  },
  {
    slug: "minimizing-latency-cpp",
    title: "lorem",
    date: "2025",
    description:
      "lorem",
  },
];
---

<Layout 
  title="Writing | Agustin Diaz-Cano"
  description="Technical notes, articles, and research on systems engineering, performance, and quantitative finance written by Agustin Diaz-Cano."
>
  <main class="min-h-screen max-w-[800px] mx-auto px-6 pb-20">

    <section class="mb-16">
      <h2 class="text-3xl font-bold tracking-tight text-white mb-3">Writing</h2>
      <p class="text-[#888]">
        Opinion
      </p>
    </section>

    <div class="space-y-12">
      {
        posts.map((post) => (
          <article class="group relative">
            <div class="flex justify-between items-baseline mb-2">
              <h2 class="text-xl font-semibold text-white group-hover:text-blue-400 transition-colors">
                <a
                  href={`/writing/${post.slug}`}
                  class="absolute inset-0 z-10 focus:outline-none"
                >
                  <span class="sr-only">Read - {post.title}</span>
                </a>
                {post.title}
              </h2>
              <span class="text-sm font-mono text-[#444]">{post.date}</span>
            </div>
            <p class="text-[#666] text-sm leading-relaxed relative z-20 pointer-events-none">
              {post.description}
            </p>
          </article>
        ))
      }
    </div>
    <div class="mt-20">
      <Footer />
    </div>
  </main>
</Layout>
