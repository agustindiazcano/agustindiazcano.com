---
import Layout from "../layouts/Layout.astro";
import Footer from "../components/Footer.astro";
import CSSBlackHole from "../components/CSSBlackHole.astro";
import usage from "../data/claude-usage/current.json";

const agents = [
  { id: "claude", name: "Claude Code", short: "CC", color: "#d6a47e", tokens: usage.claudeTotalTokens, sessions: usage.sessions, note: "Anthropic", icon: "/icons/agents/claude.svg" },
  { id: "antigravity", name: "Antigravity", short: "AG", color: "#a99bf2", tokens: usage.antigravity.totalTokens, sessions: usage.antigravity.sessions, note: "Google", icon: "/icons/agents/antigravity.svg" },
  { id: "codex", name: "Codex", short: "CX", color: "#80d3bf", tokens: usage.codex.totalTokens, sessions: usage.codex.sessions, note: "OpenAI", icon: "/icons/agents/codex.svg" },
  { id: "metamuse", name: "Meta Muse", short: "MM", color: "#6ea8fe", tokens: usage.metamuse.totalTokens, sessions: usage.metamuse.sessions, note: "Meta", icon: "/icons/agents/metamuse.svg" },
  { id: "grok", name: "Grok", short: "GK", color: "#ededed", tokens: usage.grok.totalTokens, sessions: usage.grok.sessions, note: "xAI", icon: "/icons/agents/grok.svg" },
  { id: "cursor", name: "Cursor", short: "CU", color: "#ff9d6b", tokens: usage.cursor.totalTokens, sessions: usage.cursor.sessions, note: "Anysphere", icon: "/icons/agents/cursor.svg" },
];

const total = agents.reduce((sum, agent) => sum + agent.tokens, 0);
const sessions = agents.reduce((sum, agent) => sum + agent.sessions, 0);
const format = (value: number) => value >= 1e9 ? `${(value / 1e9).toFixed(2)}B` : `${(value / 1e6).toFixed(1)}M`;
const medianMonths = Math.round(total / 51e6);
const powerMonths = Math.round(total / 380e6);
const source = "https://jellyfish.co/blog/is-tokenmaxxing-cost-effective-new-data-from-jellyfish-explains/";
const linkClass = "inline-flex items-center gap-1.5 text-xs px-2.5 py-1 rounded-md border border-[#262626] bg-[#161616] text-[#999] hover:text-white hover:bg-[#222] transition-colors font-mono";
---

<Layout
  title="AI Usage Dashboard | Agustin Diaz-Cano"
  description="Explore Agustin Diaz-Cano's 30-day AI agent token usage across Claude Code, Antigravity, Codex, Meta Muse, Grok and Cursor, alongside the AFAW multi-agent methodology and Jellyfish benchmarks."
>
  <CSSBlackHole />
  <main class="min-h-screen max-w-[1100px] mx-auto px-6 pb-16 relative z-10">
    <nav class="flex items-center gap-2 text-xs font-mono text-[#666] mb-6 pt-2" aria-label="Breadcrumb">
      <a href="/" class="hover:text-white transition-colors">HOME</a>
      <span>/</span>
      <span class="text-[#888]">AI USAGE</span>
    </nav>

    {/* Header + filters */}
    <header class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-5">
      <div>
        <h1 class="text-3xl md:text-4xl font-bold tracking-tight text-white mb-1">AI Usage</h1>
        <p class="text-[#888] text-sm max-w-xl leading-relaxed">
          Multi-model token telemetry across 30 days of active software engineering.
          <span class="font-mono text-[11px] text-[#555] block mt-1">Last 30 days · {usage.period}</span>
        </p>
      </div>
      <div class="flex flex-wrap items-center gap-1.5" role="group" aria-label="Agent filter">
        <button type="button" class="filter-btn active px-2.5 py-1 rounded-lg border border-white bg-white text-black font-mono text-xs transition-colors cursor-pointer" data-agent="all" aria-pressed="true">All</button>
        {agents.map(agent => (
          <button type="button" class="filter-btn px-2.5 py-1 rounded-lg border border-[#222] bg-[#111] text-[#888] hover:text-white hover:border-[#444] font-mono text-xs transition-colors flex items-center gap-1.5 cursor-pointer" data-agent={agent.id} aria-pressed="false">
            <span class="inline-block w-2 h-2 rounded-full" style={`background-color: ${agent.color}`}></span>
            {agent.name}
          </button>
        ))}
      </div>
    </header>

    {/* Stats strip */}
    <section class="grid grid-cols-2 lg:grid-cols-4 gap-px bg-[#222] border border-[#222] rounded-2xl overflow-hidden mb-4" aria-label="Usage overview" aria-live="polite">
      <div class="bg-[#111] p-5">
        <span class="font-mono text-[10px] uppercase tracking-wider text-[#666]">Total tokens</span>
        <div id="total-value" class="text-3xl md:text-4xl font-bold font-mono tracking-tight text-white mt-1">{format(total)}</div>
        <p id="total-exact" class="text-[11px] font-mono text-[#666] mt-1">{total.toLocaleString("en-US")} processed tokens</p>
      </div>
      <div class="bg-[#111] p-5">
        <span class="font-mono text-[10px] uppercase tracking-wider text-[#666]">Sessions</span>
        <div id="session-value" class="text-3xl md:text-4xl font-bold font-mono tracking-tight text-white mt-1">{sessions}</div>
        <p class="text-[11px] font-mono text-[#666] mt-1">Interactive workflows</p>
      </div>
      <div class="bg-[#111] p-5">
        <span class="font-mono text-[10px] uppercase tracking-wider text-[#666]">Agents</span>
        <div id="agent-value" class="text-3xl md:text-4xl font-bold font-mono tracking-tight text-white mt-1">{String(agents.length).padStart(2, "0")}</div>
        <p id="agent-caption" class="text-[11px] font-mono text-[#666] mt-1">In this snapshot</p>
      </div>
      <div class="bg-[#111] p-5">
        <span class="font-mono text-[10px] uppercase tracking-wider text-[#666]">Equivalent to</span>
        <div class="mt-1 font-mono text-white">
          <span id="median-months" class="text-2xl font-bold">{medianMonths}</span><span class="text-xs text-[#888]"> mo · median dev (51M/mo)</span>
        </div>
        <div class="font-mono text-white">
          <span id="power-months" class="text-2xl font-bold">{powerMonths}</span><span class="text-xs text-[#888]"> mo · power dev (380M/mo)</span>
        </div>
      </div>
    </section>

    {/* Breakdown: one stacked bar and one list */}
    <section class="bg-[#111] border border-[#222] rounded-2xl p-5 mb-4" aria-labelledby="breakdown-heading">
      <div class="flex items-center justify-between mb-3">
        <h2 id="breakdown-heading" class="font-mono text-xs uppercase tracking-wider text-[#888]">Share by agent</h2>
        <span class="text-[10px] font-mono text-[#555]">Tokens · sessions · share</span>
      </div>
      <div class="h-3 rounded-full bg-[#1c1c1c] overflow-hidden flex gap-0.5 mb-5" aria-label="Share of combined tokens by agent">
        {agents.map(agent => (
          <span style={`width:${(agent.tokens / total) * 100}%; background-color:${agent.color}`} title={`${agent.name}: ${((agent.tokens / total) * 100).toFixed(1)}%`}></span>
        ))}
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-4">
        {agents.map(agent => {
          const share = total > 0 ? (agent.tokens / total) * 100 : 0;
          return (
            <div data-agent-row={agent.id} class="transition-opacity">
              <div class="flex items-center justify-between gap-3 mb-1.5">
                <div class="flex items-center gap-2.5 min-w-0">
                  <img src={agent.icon} alt={`${agent.name} logo`} width="16" height="16" loading="lazy" class="opacity-90 flex-shrink-0" />
                  <span class="text-sm font-semibold text-white truncate">{agent.name}</span>
                  <span class="text-[11px] font-mono text-[#555] hidden sm:inline">{agent.note}</span>
                </div>
                <div class="flex items-center gap-3 font-mono text-xs flex-shrink-0">
                  <span class="text-white font-semibold">{agent.tokens > 0 ? format(agent.tokens) : "n/a"}</span>
                  <span class="text-[#666] w-20 text-right">{agent.sessions} {agent.sessions === 1 ? "session" : "sessions"}</span>
                  <span class="text-[#aaa] w-12 text-right">{share.toFixed(1)}%</span>
                </div>
              </div>
              <div class="h-1.5 rounded-full bg-[#181818] overflow-hidden">
                <div class="h-full rounded-full" style={`width:${share}%; background-color:${agent.color}`}></div>
              </div>
            </div>
          );
        })}
      </div>
      <p class="text-[11px] text-[#555] mt-5 pt-3 border-t border-[#1c1c1c] leading-relaxed">
        Aggregates local JSONL transcripts and cache snapshots (cached tokens included). Cursor is tracked server-side, so it exposes no local token counters.
      </p>
    </section>

    {/* Benchmark and source in one card */}
    <section class="bg-[#111] border border-[#222] rounded-2xl p-5 mb-4" aria-labelledby="benchmark-heading">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
          <h2 id="benchmark-heading" class="font-mono text-xs uppercase tracking-wider text-[#888] mb-4">Token pyramid · Jellyfish Q1 2026</h2>
          <div class="flex flex-col items-center gap-1 font-mono text-center" role="img" aria-label="Pyramid of monthly AI coding token usage per developer: below median, median to 90th percentile, 90th percentile and above, and this portfolio at the top">
            <div class="w-[38%] min-w-[120px] rounded-md bg-white text-black py-2 px-1">
              <div id="pyr-you" class="text-sm font-bold">{format(total)}</div>
              <div class="text-[10px]"><span id="pyr-mult">{(total / 380e6).toFixed(0)}</span>x P90 · observed here</div>
            </div>
            <div class="w-[58%] rounded-md bg-[#d6d6d6]/80 text-black py-2 px-1">
              <div class="text-sm font-bold">380M+ / mo</div>
              <div class="text-[10px]">Top 10% · 90th percentile and above</div>
            </div>
            <div class="w-[80%] rounded-md bg-[#777] text-white py-2 px-1">
              <div class="text-sm font-bold">51M to 380M / mo</div>
              <div class="text-[10px]">Median to 90th percentile</div>
            </div>
            <div class="w-full rounded-md bg-[#2a2a2a] text-white py-2 px-1">
              <div class="text-sm font-bold">Under 51M / mo</div>
              <div class="text-[10px]">Below the median developer</div>
            </div>
          </div>
          <p class="text-[11px] text-[#555] mt-3 leading-relaxed">Jellyfish publishes only the 50th (51M) and 90th (380M) percentile token figures, so the pyramid shows those three bands and does not invent finer tiers. The top block is this portfolio's 30-day total.</p>
        </div>
        <div class="text-sm text-[#888] leading-relaxed">
          <p>
            Jellyfish analyzed AI coding activity from <strong class="text-white font-medium">12,000 developers across 200 companies</strong> in Q1 2026. These are reference rates, not a global ranking.
          </p>
          <div class="flex flex-wrap gap-2 mt-3">
            <a href={source} target="_blank" rel="noopener noreferrer" class={linkClass}>Research paper <span aria-hidden="true">↗</span></a>
            <a href="https://jellyfish.co/state-of-ai-software-engineering/" target="_blank" rel="noopener noreferrer" class={linkClass}>Research hub <span aria-hidden="true">↗</span></a>
            <a href="https://jellyfish.co/blog/are-ai-coding-tools-making-companies-more-productive/" target="_blank" rel="noopener noreferrer" class={linkClass}>Engineering analysis <span aria-hidden="true">↗</span></a>
          </div>
        </div>
      </div>
    </section>

    {/* AFAW: compact flow and two cards */}
    <section class="mb-10" aria-labelledby="methodology-heading">
      <h2 id="methodology-heading" class="font-mono text-xs uppercase tracking-wider text-[#888] mb-1">AFAW: architecture and methodology</h2>
      <p class="text-[#888] text-sm mb-4">Multi-agent orchestration, deterministic validation, and autonomous pipelines.</p>

      <div class="bg-[#111] border border-[#222] rounded-2xl p-6 md:p-8 mb-4">
        <div class="flex items-center justify-between mb-8 pb-4 border-b border-[#1c1c1c]">
          <span class="font-mono text-xs uppercase tracking-wider text-[#666]">ARCHITECTURE DIAGRAM</span>
          <span class="text-[10px] font-mono border border-[#333] text-[#888] px-2 py-0.5 rounded-full">AFAW FLOW</span>
        </div>

        <div class="max-w-3xl mx-auto flex flex-col items-center" aria-label="AFAW methodology architecture flowchart">
          <div class="w-full bg-[#161616] border border-[#2c2c2c] rounded-xl p-5 text-center hover:border-[#444] transition-colors">
            <div class="flex items-center justify-center gap-2.5 text-white font-medium text-sm md:text-base">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-white"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
              <span>Technical Director</span>
            </div>
            <p class="text-xs font-mono text-[#888] mt-1.5">
              Defines objectives, writes prompts, and decides what to integrate
            </p>
          </div>

          <div class="py-2.5 text-[#555]" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14"/><path d="m19 12-7 7-7-7"/></svg>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-3 w-full">
            <div class="bg-[#161616] border border-[#2c2c2c] rounded-xl p-4 text-center hover:border-[#444] transition-colors">
              <div class="flex items-center justify-center gap-2 text-white font-medium text-sm">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[#aaa]"><rect width="18" height="12" x="3" y="6" rx="2"/><path d="M9 12h.01"/><path d="M15 12h.01"/><path d="M12 2v4"/><path d="M2 12h1"/><path d="M21 12h1"/></svg>
                <span>Agent A</span>
              </div>
              <p class="text-xs font-mono text-[#777] mt-1">Dedicated branch &amp; worktree</p>
            </div>
            <div class="bg-[#161616] border border-[#2c2c2c] rounded-xl p-4 text-center hover:border-[#444] transition-colors">
              <div class="flex items-center justify-center gap-2 text-white font-medium text-sm">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[#aaa]"><rect width="18" height="12" x="3" y="6" rx="2"/><path d="M9 12h.01"/><path d="M15 12h.01"/><path d="M12 2v4"/><path d="M2 12h1"/><path d="M21 12h1"/></svg>
                <span>Agent B</span>
              </div>
              <p class="text-xs font-mono text-[#777] mt-1">Dedicated branch &amp; worktree</p>
            </div>
            <div class="bg-[#161616] border border-[#2c2c2c] rounded-xl p-4 text-center hover:border-[#444] transition-colors">
              <div class="flex items-center justify-center gap-2 text-white font-medium text-sm">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[#aaa]"><rect width="18" height="12" x="3" y="6" rx="2"/><path d="M9 12h.01"/><path d="M15 12h.01"/><path d="M12 2v4"/><path d="M2 12h1"/><path d="M21 12h1"/></svg>
                <span>Agent C</span>
              </div>
              <p class="text-xs font-mono text-[#777] mt-1">Dedicated branch &amp; worktree</p>
            </div>
          </div>

          <div class="py-2.5 text-[#555]" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14"/><path d="m19 12-7 7-7-7"/></svg>
          </div>

          <div class="w-full bg-[#161616] border border-[#2c2c2c] rounded-xl p-5 text-center hover:border-[#444] transition-colors">
            <div class="flex items-center justify-center gap-2.5 text-white font-medium text-sm md:text-base">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-white"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
              <span>Deterministic Validation</span>
            </div>
            <p class="text-xs font-mono text-[#888] mt-1.5">
              Tests, CI, red-first, mutation testing, and state checks
            </p>
          </div>

          <div class="py-2.5 text-[#555]" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14"/><path d="m19 12-7 7-7-7"/></svg>
          </div>

          <div class="w-full bg-[#161616] border border-[#2c2c2c] rounded-xl p-4 text-center hover:border-[#444] transition-colors">
            <div class="flex items-center justify-center gap-2.5 text-white font-medium text-sm md:text-base">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-white"><circle cx="18" cy="18" r="3"/><circle cx="6" cy="6" r="3"/><path d="M6 9v12"/><path d="M18 15V9a9 9 0 0 0-9-9"/></svg>
              <span>Human Review &amp; Approval</span>
            </div>
          </div>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <article class="bg-[#111] border border-[#222] rounded-2xl p-5 flex flex-col justify-between">
          <div>
            <h3 class="text-sm font-semibold text-white mb-2">AFAW: Human-Directed Orchestration</h3>
            <p class="text-sm text-[#888] leading-relaxed">
              A terminal per agent with targeted roles and tasks. Agents write code in isolated git worktrees; automated suites verify correctness and regression safety before merge.
            </p>
          </div>
          <a href="https://github.com/agustindiazcano/afaw-anti-fragile-agentic-workflow" target="_blank" rel="noopener noreferrer" class={`${linkClass} mt-4 w-fit`}>
            <span>afaw-anti-fragile-agentic-workflow</span><span aria-hidden="true">↗</span>
          </a>
        </article>

        <article class="bg-[#111] border border-[#222] rounded-2xl p-5 flex flex-col justify-between">
          <div>
            <h3 class="text-sm font-semibold text-white mb-2">AFAW Engine: Automated Variant</h3>
            <p class="text-sm text-[#888] leading-relaxed">
              Autonomous lifecycle with <strong class="text-white font-medium">GitLab Duo</strong>, <strong class="text-white font-medium">self-healing CI/CD</strong>, rule-based integration decisions and continuous deployment. At this volume it is estimated at about <strong class="text-white font-mono font-medium">500 USD daily</strong> in inference tokens.
            </p>
          </div>
          <div class="flex flex-wrap gap-2 mt-4">
            <a href="https://github.com/agustindiazcano/afaw-engine-gitlab" target="_blank" rel="noopener noreferrer" class={linkClass}><span>afaw-engine-gitlab</span><span aria-hidden="true">↗</span></a>
            <a href="https://gitlab.com/gitlab-ai-hackathon/transcend-october-2026/43344247/showcase/-/merge_requests/137" target="_blank" rel="noopener noreferrer" class={linkClass}><span>GitLab MR #137</span><span aria-hidden="true">↗</span></a>
          </div>
        </article>
      </div>
    </section>

    <div class="pt-8 border-t border-[#222]">
      <Footer />
    </div>
  </main>

  <script is:inline type="application/json" id="usage-dashboard-data" set:html={JSON.stringify(agents).replace(/</g, "\\u003c")} />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const dataElement = document.getElementById("usage-dashboard-data");
    if (!dataElement) return;
    const agents = JSON.parse(dataElement.textContent || "[]") as { id: string; name: string; tokens: number; sessions: number }[];
    const format = (value: number) => value >= 1e9 ? `${(value / 1e9).toFixed(2)}B` : `${(value / 1e6).toFixed(1)}M`;
    const set = (id: string, value: string) => { const element = document.getElementById(id); if (element) element.textContent = value; };

    document.querySelectorAll<HTMLButtonElement>(".filter-btn[data-agent]").forEach(button => {
      button.addEventListener("click", () => {
        const selected = button.dataset.agent === "all" ? agents : agents.filter(agent => agent.id === button.dataset.agent);
        const tokens = selected.reduce((sum, agent) => sum + agent.tokens, 0);
        const sessions = selected.reduce((sum, agent) => sum + agent.sessions, 0);

        document.querySelectorAll<HTMLButtonElement>(".filter-btn[data-agent]").forEach(item => {
          const active = item === button;
          item.classList.toggle("bg-white", active);
          item.classList.toggle("text-black", active);
          item.classList.toggle("border-white", active);
          item.classList.toggle("bg-[#111]", !active);
          item.classList.toggle("text-[#888]", !active);
          item.classList.toggle("border-[#222]", !active);
          item.setAttribute("aria-pressed", String(active));
        });

        document.querySelectorAll<HTMLElement>("[data-agent-row]").forEach(row => {
          const dimmed = button.dataset.agent !== "all" && row.dataset.agentRow !== button.dataset.agent;
          row.classList.toggle("opacity-25", dimmed);
        });

        set("total-value", format(tokens));
        set("total-exact", tokens.toLocaleString("en-US") + " processed tokens");
        set("session-value", String(sessions));
        set("agent-value", String(selected.length).padStart(2, "0"));
        set("agent-caption", selected.length === 1 ? "Selected agent" : "In this snapshot");
        set("pyr-you", format(tokens));
        set("pyr-mult", String(Math.round(tokens / 380e6)));
        set("median-months", String(Math.round(tokens / 51e6)));
        set("power-months", String(Math.round(tokens / 380e6)));
      });
    });
  });
</script>
