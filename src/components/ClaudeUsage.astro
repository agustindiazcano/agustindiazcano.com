---
import currentUsage from "../data/claude-usage/current.json";

const rows = [
    ["Tokens", currentUsage.combined.totalTokens],
    ["Period", currentUsage.period],
    ["Sessions", currentUsage.combined.sessions],
];
---

<section id="claude-usage" class="w-full md:w-auto md:min-w-[11rem] bg-[#111] border border-[#222] rounded-md" aria-label="AI usage over the last 30 days">
    <dl class="font-mono text-[11px]">
        {rows.map(([label, value], index) => (
            <div class:list={["flex items-baseline justify-between gap-4 px-3 py-1.5", index > 0 && "border-t border-[#222]"]}>
                <dt class="text-[#888]">{label}</dt>
                <dd class="text-white whitespace-nowrap">{value}</dd>
            </div>
        ))}
    </dl>
</section>
