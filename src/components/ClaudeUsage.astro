---
import currentUsage from "../data/claude-usage/current.json";

const rows = [
    ["Tokens", currentUsage.combined.totalTokens],
    ["Sessions", currentUsage.combined.sessions],
];
---

<section id="claude-usage" class="usage-glass" aria-label="AI usage over the last 30 days">
    <a href="/agents-usage" class="usage-lead">AI Usage <span aria-hidden="true">&#8599;</span></a>
    <div class="usage-period">
        <span>Period</span>
        <span class="usage-nowrap">{currentUsage.period}</span>
    </div>
    <dl class="usage-stats">
        {rows.map(([label, value]) => (
            <div class="usage-stat">
                <dt>{label}</dt>
                <dd class="usage-nowrap">{value}</dd>
            </div>
        ))}
    </dl>
</section>

<style>
    /* Same frosted dark glass with soft neumorphic depth as the home profile panel and nav buttons */
    .usage-glass {
        position: relative;
        display: flex;
        align-items: stretch;
        width: fit-content;
        max-width: 100%;
        overflow: hidden;
        border-radius: var(--glass-radius);
        font-family: var(--font-mono);
        background:
            linear-gradient(145deg, rgba(255, 255, 255, 0.07), rgba(255, 255, 255, 0.015) 50%, rgba(255, 255, 255, 0.035)),
            rgba(8, 8, 10, 0.78);
        -webkit-backdrop-filter: blur(16px) saturate(170%);
        backdrop-filter: blur(16px) saturate(170%);
        border: 1px solid rgba(255, 255, 255, 0.1);
        box-shadow:
            inset 0 1px 0 rgba(255, 255, 255, 0.18),
            inset 0 -1px 0 rgba(0, 0, 0, 0.45),
            -3px -3px 10px rgba(255, 255, 255, 0.02),
            6px 8px 18px rgba(0, 0, 0, 0.5);
    }
    .usage-nowrap {
        white-space: nowrap;
    }

    /* Mobile (below 768px): the bar is as wide as the profile card, data spread evenly */
    @media (max-width: 767px) {
        .usage-glass {
            width: 100%;
        }
        .usage-stats {
            flex: 1;
        }
        .usage-stat {
            flex: 1;
            justify-content: center;
        }
    }

    /* The bar is attached to the top edge of the profile card: no bottom border/radius, no drop shadow */
    .usage-glass {
        border-bottom: 0;
        border-bottom-left-radius: 0;
        border-bottom-right-radius: 0;
        box-shadow:
            inset 0 1px 0 rgba(255, 255, 255, 0.18),
            -3px -3px 10px rgba(255, 255, 255, 0.02);
    }

    /* One compact bar, AI Usage button first, then the usage data to its right */
    .usage-lead,
    .usage-period,
    .usage-stat {
        display: flex;
        align-items: baseline;
        gap: 0.5rem;
        padding: 0.5rem 0.75rem;
        font-size: 11px;
        line-height: 1.2;
    }
    .usage-lead {
        color: #ffffff;
        white-space: nowrap;
        background-color: transparent;
        transition: color 0.5s ease, background-color 0.5s ease, box-shadow 0.5s ease, text-shadow 0.5s ease;
    }
    /* Hover glow like the nav buttons: lighter background, inner yellow glow and a soft text glow */
    .usage-lead:hover,
    .usage-lead:focus-visible {
        color: #efd98a;
        background-color: rgba(52, 52, 60, 0.7);
        box-shadow: inset 0 0 16px rgba(239, 217, 138, 0.3);
        text-shadow: 0 0 10px rgba(239, 217, 138, 0.55);
    }
    .usage-period {
        display: none;
        color: #ffffff;
        font-size: 10px;
        border-left: 1px solid rgba(255, 255, 255, 0.08);
    }
    .usage-stats {
        display: flex;
    }
    .usage-stat {
        border-left: 1px solid rgba(255, 255, 255, 0.08);
    }
    .usage-stat dt {
        color: #888;
    }
    .usage-stat dd {
        color: #ffffff;
    }
    @media (min-width: 640px) {
        .usage-period {
            display: flex;
        }
    }

    @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
        .usage-glass {
            background: rgba(8, 8, 10, 0.94);
        }
    }
</style>
