---
import currentUsage from "../data/claude-usage/current.json";

const rows = [
    ["Tokens", currentUsage.combined.totalTokens],
    ["Sessions", currentUsage.combined.sessions],
];
---

<section id="claude-usage" class="usage-glass" aria-label="AI usage over the last 30 days">
    <a href="/agents-usage" class="usage-lead">AI Usage <span aria-hidden="true">&#8599;</span></a>
    <div class="usage-period">
        <span>Period</span>
        <span class="usage-nowrap">{currentUsage.period}</span>
    </div>
    <dl class="usage-stats">
        {rows.map(([label, value]) => (
            <div class="usage-stat">
                <dt>{label}</dt>
                <dd class="usage-nowrap">{value}</dd>
            </div>
        ))}
    </dl>
</section>

<style>
    /* Same frosted dark glass with soft neumorphic depth as the home profile panel and nav buttons */
    .usage-glass {
        position: relative;
        display: flex;
        align-items: stretch;
        width: fit-content;
        max-width: 100%;
        overflow: hidden;
        border-radius: var(--glass-radius);
        font-family: var(--font-mono);
        background:
            linear-gradient(145deg, rgba(255, 255, 255, 0.07), rgba(255, 255, 255, 0.015) 50%, rgba(255, 255, 255, 0.035)),
            rgba(8, 8, 10, 0.78);
        -webkit-backdrop-filter: blur(16px) saturate(170%);
        backdrop-filter: blur(16px) saturate(170%);
        border: 1px solid rgba(255, 255, 255, 0.1);
        box-shadow:
            inset 0 1px 0 rgba(255, 255, 255, 0.18),
            inset 0 -1px 0 rgba(0, 0, 0, 0.45),
            -3px -3px 10px rgba(255, 255, 255, 0.02),
            6px 8px 18px rgba(0, 0, 0, 0.5);
    }
    .usage-nowrap {
        white-space: nowrap;
    }

    /* Below 1216px: one compact bar, AI Usage button first, then the usage data to its right */
    .usage-lead,
    .usage-period,
    .usage-stat {
        display: flex;
        align-items: baseline;
        gap: 0.5rem;
        padding: 0.5rem 0.75rem;
        font-size: 11px;
        line-height: 1.2;
    }
    .usage-lead {
        color: #ffffff;
        white-space: nowrap;
        transition: color 0.2s ease;
    }
    .usage-lead:hover,
    .usage-lead:focus-visible {
        color: #efd98a;
    }
    .usage-period {
        display: none;
        color: #ffffff;
        font-size: 10px;
        border-left: 1px solid rgba(255, 255, 255, 0.08);
    }
    .usage-stats {
        display: flex;
    }
    .usage-stat {
        border-left: 1px solid rgba(255, 255, 255, 0.08);
    }
    .usage-stat dt {
        color: #888;
    }
    .usage-stat dd {
        color: #ffffff;
    }
    @media (min-width: 640px) {
        .usage-period {
            display: flex;
        }
    }

    /* 1216px and up: compact two-row card. Row 1: AI Usage button + period. Row 2: tokens + sessions. */
    @media (min-width: 1216px) {
        .usage-glass {
            display: grid;
            grid-template-columns: auto auto;
            width: auto;
        }
        .usage-stats {
            display: contents;
        }
        .usage-lead,
        .usage-period,
        .usage-stat {
            padding: 0.3rem 0.65rem;
        }
        .usage-period {
            justify-content: flex-end;
            font-size: 9px;
            border-left: 0;
        }
        .usage-stat {
            justify-content: space-between;
            gap: 1rem;
            border-left: 0;
            border-top: 1px solid rgba(255, 255, 255, 0.08);
        }
        .usage-stat:last-child {
            border-left: 1px solid rgba(255, 255, 255, 0.08);
        }
    }

    @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
        .usage-glass {
            background: rgba(8, 8, 10, 0.94);
        }
    }
</style>
