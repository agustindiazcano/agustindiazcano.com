---
export interface Props {
    title: string;
    description?: string;
    image?: string;
}

const { 
    title, 
    description = "Software Engineer | AI/ML & Backend | MS Candidate", 
    image = "/images/agustin-diaz-cano-software-engineer-1.png" 
} = Astro.props;

// URL Schema
const siteUrl = Astro.site ? Astro.site.toString() : "https://www.agustindiazcano.com";
const imageUrl = new URL(image, siteUrl).toString();

const schema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Agustin Diaz-Cano",
  "url": siteUrl,
  "image": imageUrl,
  "jobTitle": "Software Engineer",
  "description": description,
  "alumniOf": [
    {
      "@type": "CollegeOrUniversity",
      "name": "Universidad Tecnológica Nacional",
      "sameAs": "https://www.utn.edu.ar/"
    },
    {
      "@type": "CollegeOrUniversity",
      "name": "Universidad de Palermo",
      "sameAs": "https://www.palermo.edu/"
    }
  ],
  "knowsAbout": [
    // CORE ENGINEERING
    "C++",
    "Python",
    "TypeScript",
    "JavaScript",
    "SQL",

    // BACKEND & FULLSTACK
    "Backend Development",
    "Frontend Development",
    "Full Stack Development",
    "React",
    "Node.js",
    "FastAPI",
    "Django",
    "PostgreSQL",
    "MongoDB",
    "Docker",
    "CI/CD",
    "GitHub Actions",

    // ROBOTICS & SIMULATION
    "Robotics",
    "MuJoCo",
    "Physics Simulation",

    // GAME DEV & GRAPHICS
    "Game Development",

    // AI / ML / GENAI
    "Artificial Intelligence",
    "Machine Learning",
    "Deep Learning",
    "PyTorch",
    "JAX",
    "NumPy",
    "Pandas",
    "Large Language Models (LLM)",
    "Retrieval-Augmented Generation (RAG)",
    "Model Context Protocol (MCP)",
    "LangChain",
    "LangGraph",
    "AI Agents",
    "Genetic Algorithms",
    "Fuzzy Logic",
    "Data Mining",

    // CLOUD & INFRASTRUCTURE
    "Amazon Web Services (AWS)",
    "Google Cloud Platform (GCP)",
    "Google Vertex AI",
    "Amazon Bedrock",

    // QA & RELIABILITY
    "Test Automation",
    "SDET",
    "Digital Forensics",
    "System Reliability",

    // FINANCE & ECONOMICS
    "Quantitative Finance",
    "Corporate Finance",
    "Economics",
    "Financial Calculus",

    // MATH & THEORY
    "Statistics",
    "Calculus"
  ],
  "sameAs": [
    "https://github.com/agustindiazcano",
    "https://linkedin.com/in/agustindiazcano",
    "https://www.researchgate.net/profile/Agustin-Diaz-Cano",
    "https://orcid.org/0009-0001-4336-490X",
    "https://www.moddb.com/members/heroagastin",
    "https://x.com/adiazcano_",
    "https://steamcommunity.com/id/agustindiazcano/",
    "https://www.labolsavirtual.com/marcelogallardiola",
    "https://www.youtube.com/@agusdiazcano",
    "https://medium.com/@agustindiazcano",
    "https://dev.to/agustindiazcano",
    "https://scholar.google.com/citations?user=qUcRD6UAAAAJ&hl=en",
    "https://agustindiazcano2020.netlify.app/",
    "https://ar.pinterest.com/agusdiazcano/",
    "https://agustindiazcano.blogspot.com/"
  ]
};
---

<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<link rel="canonical" href={new URL(Astro.url.pathname, siteUrl)} />

<meta property="og:type" content="website" /> <meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:alt" content="Agustin Diaz-Cano" />

<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={imageUrl} />
<meta property="twitter:image:alt" content="Agustin Diaz-Cano" />

<script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />