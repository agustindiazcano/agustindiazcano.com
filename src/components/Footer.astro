---
import { aggregateAnalytics } from '../utils/analytics';
export interface Props {
    isHome?: boolean;
}

const { isHome = false } = Astro.props;
const currentYear = new Date().getFullYear();
const lastUpdated = new Date().toLocaleDateString('en-US', { month: 'short', year: 'numeric' });

const globResult = import.meta.glob('../data/analytics/*.json', { eager: true });
const analytics = aggregateAnalytics(globResult);

const links = [
    { name: "GitHub", href: "/github" },
    { name: "LinkedIn", href: "https://linkedin.com/in/agustindiazcano" },
    {
        name: "ResearchGate",
        href: "https://www.researchgate.net/profile/Agustin-Diaz-Cano",
    },
    { name: "ORCID", href: "https://orcid.org/0009-0001-4336-490X" },
    { name: "ModDB", href: "https://www.moddb.com/members/heroagastin" },
    { name: "X (Twitter)", href: "https://x.com/adiazcano_" },
    { name: "Steam", href: "https://steamcommunity.com/id/agustindiazcano/" },
    {
        name: "La Bolsa Virtual",
        href: "https://www.labolsavirtual.com/marcelogallardiola",
    },
    { name: "YouTube", href: "https://www.youtube.com/@agusdiazcano" },
    { name: "Medium", href: "https://medium.com/@agustindiazcano" },
    { name: "Dev.to", href: "https://dev.to/agustindiazcano" },
    { name: "Google Scholar", href: "https://scholar.google.com/citations?user=qUcRD6UAAAAJ&hl=en" },
    { name: "42k Marathon & Running Log", href: "/running-agustin-diaz-cano" },
    { name: "llms.txt", href: "/llms.txt" },
    { name: "llms-full.txt", href: "/llms-full.txt" },
];

const textColor = isHome ? "text-white/90" : "text-[#444]";
---

<footer
    class={`w-full border-t border-[#222] pt-12 pb-12 flex flex-col items-center justify-center text-sm gap-8 ${textColor}`}
>
    <div class="flex gap-4 flex-wrap justify-center max-w-3xl">
        {
            links.map((link) => (
                <a
                    href={link.href}
                    target={link.href.startsWith("http") ? "_blank" : "_self"}
                    rel={
                        link.href.startsWith("http")
                            ? "noopener noreferrer me"
                            : ""
                    }
                    class="transition-colors hover:text-white"
                >
                    {link.name}
                </a>
            ))
        }
    </div>
    <div class="flex flex-col md:flex-row items-center justify-between w-full mt-4 border-t border-[#222] pt-6 gap-5 md:gap-0">
        <div class="contents md:flex md:items-center md:gap-6">
            <p class="order-1 md:order-none">© {currentYear} Agustin Diaz-Cano</p>
            <p class="text-[#888] text-sm order-3 md:order-none">Last Updated: {lastUpdated}</p>
        </div>
        
        <div class="flex items-center gap-3 order-2 md:order-none">
            <a href="/juego31.html" class="text-[#333] hover:text-white transition-colors" title="Follow the white rabbit">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 16a3 3 0 0 1 2.24 5"/><path d="M18 12h.01"/><path d="M18 21h-8a4 4 0 0 1-4-4 7 7 0 0 1 7-7h.2L9.6 6.4a1 1 0 1 1 2.8-2.8L15.8 7h.2c3.3 0 6 2.7 6 6v1a2 2 0 0 1-2 2h-1a3 3 0 0 0-3 3"/><path d="M20 8.54V4a2 2 0 1 0-4 0v3"/><path d="M7.612 12.524a3 3 0 1 0-1.6 4.3"/></svg>
            </a>
            <div class="relative group">
                <button id="visitors-btn" class="px-4 py-2 border border-[#333] rounded-md text-sm hover:bg-[#111] transition-colors flex items-center gap-2">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
                    Visitors
                </button>
                
                {/* Tooltip Card */}
            <div id="visitors-tooltip" class="absolute bottom-full mb-3 left-1/2 -translate-x-1/2 opacity-0 group-hover:opacity-100 pointer-events-none transition-all duration-300 w-80 bg-[#111] border border-[#333] rounded-xl p-4 shadow-xl z-50 text-left">
                <div class="flex justify-between items-center mb-4 px-2">
                    <div class="flex flex-col">
                        <span class="text-sm text-[#aaa] mb-1">Visitors</span>
                        <span class="text-3xl font-bold text-white">{analytics.visitors}</span>
                    </div>
                    <div class="w-px h-12 bg-[#333]"></div>
                    <div class="flex flex-col items-end">
                        <span class="text-sm text-[#aaa] mb-1">Page Views</span>
                        <span class="text-3xl font-bold text-white">{analytics.pageViews}</span>
                    </div>
                </div>
                
                <div class="border-t border-[#333] pt-4">
                    <div class="flex justify-between items-center text-[10px] font-mono text-[#666] uppercase tracking-wider mb-3 px-1">
                        <span>Countries</span>
                        <div class="flex items-center gap-3">
                            <span class="w-8 text-right">%</span>
                            <span class="w-6 text-right">Vis</span>
                            <span class="w-8 text-right">Views</span>
                        </div>
                    </div>
                    
                    <div class="space-y-2.5 max-h-[250px] overflow-y-auto pr-2 custom-scrollbar">
                        {analytics.countries.map(country => (
                            <div class="flex justify-between items-center text-sm text-[#aaa] hover:bg-[#1a1a1a] p-1 rounded transition-colors">
                                <span class="flex items-center gap-2">
                                    <img src={`https://flagcdn.com/${country.code}.svg`} alt={`${country.name} flag`} width="16" loading="lazy" class="w-4 h-auto rounded-[2px]" /> 
                                    {country.name}
                                </span>
                                <div class="flex items-center gap-3">
                                    <span class="text-[#666] w-8 text-right">
                                        {analytics.visitors > 0 ? Math.round((country.visitors / analytics.visitors) * 100) : 0}%
                                    </span>
                                    <span class="font-bold text-white w-6 text-right">{country.visitors}</span>
                                    <span class="font-bold text-white w-8 text-right">{country.views}</span>
                                </div>
                            </div>
                        ))}
                    </div>
                </div>
            </div>
            </div>
        </div>
    </div>
</footer>

<style>
    .custom-scrollbar::-webkit-scrollbar {
        width: 4px;
    }
    .custom-scrollbar::-webkit-scrollbar-track {
        background: transparent;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb {
        background: #333;
        border-radius: 4px;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb:hover {
        background: #555;
    }
    
    .show-tooltip {
        opacity: 1 !important;
        pointer-events: auto !important;
    }
</style>
<script>
    document.addEventListener("astro:page-load", () => {
        const btn = document.getElementById("visitors-btn");
        const tooltip = document.getElementById("visitors-tooltip");
        if (btn && tooltip) {
            btn.addEventListener("click", (e) => {
                e.stopPropagation();
                tooltip.classList.toggle("show-tooltip");
            });
            document.addEventListener("click", (e) => {
                if (!tooltip.contains(e.target)) {
                    tooltip.classList.remove("show-tooltip");
                }
            });
        }
    });
</script>
