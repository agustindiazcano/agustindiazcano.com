---

<nav id="site-nav" class="flex flex-wrap justify-center min-[1216px]:justify-end gap-1.5 md:gap-2 w-full">
    {/* Mobile: hamburger toggles the menu below. md and up: the menu container is transparent (display: contents). */}
    <button
        id="nav-burger"
        type="button"
        class="nav-burger nav-glass md:hidden p-2.5 flex items-center justify-center cursor-pointer"
        aria-label="Menu"
        aria-expanded="false"
        aria-controls="nav-menu"
    >
        <svg class="burger-open" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" y1="7" x2="20" y2="7"/><line x1="4" y1="12" x2="20" y2="12"/><line x1="4" y1="17" x2="20" y2="17"/></svg>
        <svg class="burger-close" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="6" y1="6" x2="18" y2="18"/><line x1="18" y1="6" x2="6" y2="18"/></svg>
    </button>
    <div id="nav-menu" class="nav-menu md:contents">
    {
        links.map((link) => (
            <a
                href={link.href}
                target={link.target || "_self"}
                rel={link.target === "_blank" ? "noopener noreferrer" : undefined}
                data-nav-href={link.href}
                data-nav-match={link.match}
                class="nav-link nav-glass px-2.5 py-1.5 md:px-4 md:py-2 text-xs md:text-sm font-medium flex items-center gap-2"
            >
                {link.icon && <Fragment set:html={link.icon} />}
                <span>{link.name}</span>
            </a>
        ))
    }
    {
        socialLinks.map((social) => (
            <a
                href={social.href}
                target={social.target || "_self"}
                rel={social.target === "_blank" ? "noopener noreferrer" : undefined}
                class="nav-glass hidden md:max-[1215px]:flex p-2 md:p-2.5 items-center justify-center self-center"
                aria-label={social.name}
            >
                <Fragment set:html={social.icon} />
            </a>
        ))
    }
    <div class="relative group flex items-center self-center">
        <button
            id="nav-rabbit-btn"
            type="button"
            class="nav-rabbit nav-glass p-2 flex items-center justify-center cursor-pointer"
            aria-label="Follow the white rabbit"
        >
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 16a3 3 0 0 1 2.24 5"/><path d="M18 12h.01"/><path d="M18 21h-8a4 4 0 0 1-4-4 7 7 0 0 1 7-7h.2L9.6 6.4a1 1 0 1 1 2.8-2.8L15.8 7h.2c3.3 0 6 2.7 6 6v1a2 2 0 0 1-2 2h-1a3 3 0 0 0-3 3"/><path d="M20 8.54V4a2 2 0 1 0-4 0v3"/><path d="M7.612 12.524a3 3 0 1 0-1.6 4.3"/></svg>
        </button>

        {/* Floating tooltip above rabbit */}
        <div
            class="pointer-events-none absolute top-full mt-2 left-1/2 -translate-x-1/2 opacity-0 group-hover:opacity-100 group-hover:translate-y-1 transition-all duration-200 z-50 whitespace-nowrap px-2.5 py-1 text-xs font-mono tracking-tight text-white bg-[#111] border border-[#333] rounded-md shadow-lg shadow-black/60 hidden md:flex items-center"
        >
            <span>Follow the white rabbit</span>
            <div class="absolute -top-1 left-1/2 -translate-x-1/2 w-2 h-2 bg-[#111] border-t border-l border-[#333] rotate-45"></div>
        </div>
    </div>
    <a

        href="/agents-usage"
        class={`${compact ? "min-[1216px]:hidden" : "hidden"} nav-glass self-center flex items-center gap-1 px-2.5 py-2 text-[11px] font-mono`}
    >AI Usage <span aria-hidden="true">&#8599;</span></a>
    </div>
</nav>

<style>
    /* Mobile menu (below 768px): hamburger top-right, links in a dropdown glass panel that fades and slides in */
    .nav-burger {
        position: relative;
    }
    .nav-burger svg {
        position: absolute;
        transition: opacity 0.25s ease, transform 0.3s ease;
    }
    .nav-burger .burger-close {
        opacity: 0;
        transform: rotate(-90deg) scale(0.6);
    }
    .nav-burger[aria-expanded="true"] .burger-open {
        opacity: 0;
        transform: rotate(90deg) scale(0.6);
    }
    .nav-burger[aria-expanded="true"] .burger-close {
        opacity: 1;
        transform: none;
    }
    @media (max-width: 767px) {
        .nav-burger {
            position: absolute;
            top: 0;
            right: 0;
            z-index: 60;
            width: 2.75rem;
            height: 2.75rem;
        }
        .nav-menu {
            display: flex;
            flex-direction: column;
            align-items: stretch;
            gap: 0.55rem;
            position: absolute;
            top: 3.25rem;
            right: 0;
            z-index: 50;
            min-width: 16rem;
            padding: 0.75rem;
            border-radius: var(--glass-radius);
            background: rgba(8, 8, 10, 0.94);
            -webkit-backdrop-filter: blur(18px) saturate(170%);
            backdrop-filter: blur(18px) saturate(170%);
            border: 1px solid rgba(255, 255, 255, 0.12);
            box-shadow: 8px 12px 28px rgba(0, 0, 0, 0.6);
            /* closed state */
            opacity: 0;
            visibility: hidden;
            pointer-events: none;
            transform: translateY(-10px) scale(0.97);
            transform-origin: top right;
            transition: opacity 0.28s ease, transform 0.32s cubic-bezier(0.16, 1, 0.3, 1), visibility 0s linear 0.32s;
        }
        .nav-menu.open {
            opacity: 1;
            visibility: visible;
            pointer-events: auto;
            transform: none;
            transition: opacity 0.28s ease, transform 0.32s cubic-bezier(0.16, 1, 0.3, 1), visibility 0s;
        }
        .nav-menu > .nav-link {
            width: 100%;
            padding: 0.85rem 1rem;
            font-size: 1rem;
            gap: 0.75rem;
            opacity: 0;
            transform: translateY(-6px);
            transition: opacity 0.3s ease, transform 0.3s ease, color 0.3s ease, background-color 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
        }
        .nav-menu.open > .nav-link {
            opacity: 1;
            transform: none;
        }
        .nav-menu.open > .nav-link:nth-child(1) { transition-delay: 0.04s; }
        .nav-menu.open > .nav-link:nth-child(2) { transition-delay: 0.08s; }
        .nav-menu.open > .nav-link:nth-child(3) { transition-delay: 0.12s; }
        .nav-menu.open > .nav-link:nth-child(4) { transition-delay: 0.16s; }
        .nav-menu.open > .nav-link:nth-child(5) { transition-delay: 0.2s; }
        .nav-menu.open > .nav-link:nth-child(6) { transition-delay: 0.24s; }
        .nav-menu > .nav-link svg {
            width: 20px;
            height: 20px;
        }
        .nav-menu > div {
            align-self: center;
        }
    }

    .nav-glass {
        border-radius: var(--glass-radius);
        color: #b5b5b5;
        background-image: linear-gradient(145deg, rgba(255, 255, 255, 0.07), rgba(255, 255, 255, 0.015) 50%, rgba(255, 255, 255, 0.035));
        background-color: rgba(8, 8, 10, 0.78);
        -webkit-backdrop-filter: blur(16px) saturate(170%);
        backdrop-filter: blur(16px) saturate(170%);
        border: 1px solid rgba(255, 255, 255, 0.1);
        box-shadow:
            inset 0 1px 0 rgba(255, 255, 255, 0.18),
            inset 0 -1px 0 rgba(0, 0, 0, 0.45),
            -3px -3px 10px rgba(255, 255, 255, 0.02),
            6px 8px 18px rgba(0, 0, 0, 0.5);
        transition: color 0.3s ease, background-color 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease, transform 0.3s ease;
    }
    .nav-glass:hover {
        color: #ffffff;
        background-color: rgba(52, 52, 60, 0.7);
        border-color: rgba(255, 255, 255, 0.22);
        transform: translateY(-1px);
        box-shadow:
            inset 0 1px 0 rgba(255, 255, 255, 0.26),
            inset 0 -1px 0 rgba(0, 0, 0, 0.45),
            -3px -3px 10px rgba(255, 255, 255, 0.03),
            8px 12px 22px rgba(0, 0, 0, 0.55),
            0 0 18px rgba(239, 217, 138, 0.3);
    }
    .nav-glass.is-active {
        color: #ffffff;
        background-color: rgba(44, 44, 52, 0.72);
        border-color: rgba(239, 217, 138, 0.55);
        box-shadow:
            inset 0 1px 0 rgba(255, 255, 255, 0.24),
            inset 0 -1px 0 rgba(0, 0, 0, 0.45),
            inset 0 0 14px rgba(239, 217, 138, 0.12),
            6px 8px 18px rgba(0, 0, 0, 0.5);
    }
    .nav-glass.is-active:hover {
        background-color: rgba(58, 58, 66, 0.74);
        border-color: rgba(239, 217, 138, 0.7);
        box-shadow:
            inset 0 1px 0 rgba(255, 255, 255, 0.28),
            inset 0 -1px 0 rgba(0, 0, 0, 0.45),
            inset 0 0 14px rgba(239, 217, 138, 0.16),
            8px 12px 22px rgba(0, 0, 0, 0.55),
            0 0 20px rgba(239, 217, 138, 0.38);
    }
    @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
        .nav-glass {
            background: rgba(8, 8, 10, 0.94);
        }
    }
    .rabbit-glow {
        animation: rabbitGlow 3s ease-in-out;
    }
    
    @keyframes rabbitGlow {
        0% { filter: drop-shadow(0 0 0px rgba(255, 255, 255, 0)); }
        20% { filter: drop-shadow(0 0 10px rgba(255, 255, 255, 0.9)); color: white; border-color: rgba(255, 255, 255, 0.5); }
        80% { filter: drop-shadow(0 0 10px rgba(255, 255, 255, 0.9)); color: white; border-color: rgba(255, 255, 255, 0.5); }
        100% { filter: drop-shadow(0 0 0px rgba(255, 255, 255, 0)); }
    }
</style>

<script>
    const ACTIVE = ["is-active"];
    const INACTIVE: string[] = [];

    // Mobile hamburger menu
    function closeNavMenu() {
        const btn = document.getElementById("nav-burger");
        const menu = document.getElementById("nav-menu");
        menu?.classList.remove("open");
        btn?.setAttribute("aria-expanded", "false");
    }
    function bindNavBurger() {
        const btn = document.getElementById("nav-burger");
        const menu = document.getElementById("nav-menu");
        if (!btn || !menu) return;
        btn.onclick = (e) => {
            e.stopPropagation();
            const open = menu.classList.toggle("open");
            btn.setAttribute("aria-expanded", String(open));
        };
        menu.querySelectorAll("a").forEach((a) => a.addEventListener("click", closeNavMenu));
    }
    document.addEventListener("click", (e) => {
        const menu = document.getElementById("nav-menu");
        if (menu?.classList.contains("open") && !menu.contains(e.target as Node)) closeNavMenu();
    });
    document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") closeNavMenu();
    });
    window.addEventListener("resize", () => {
        if (window.innerWidth >= 768) closeNavMenu();
    });
    bindNavBurger();

    function updateActiveNav() {
        const pathname = window.location.pathname;
        const links =
            document.querySelectorAll<HTMLAnchorElement>("#site-nav .nav-link");

        links.forEach((link) => {
            const href = link.dataset.navHref ?? "";
            const match = link.dataset.navMatch ?? "startsWith";

            let isActive = false;
            if (match === "exact") {
                isActive = pathname === "/" || pathname === href;
            } else if (match === "startsWith") {
                isActive = href !== "/" && pathname.startsWith(href);
            }
            // "external" is always inactive

            link.classList.remove(...ACTIVE, ...INACTIVE);
            link.classList.add(...(isActive ? ACTIVE : INACTIVE));
        });
    }

    // Run immediately on hard load
    updateActiveNav();

    function bindNavRabbit() {
        const btn = document.getElementById("nav-rabbit-btn");
        if (!btn) return;
        btn.onclick = (e) => {
            e.preventDefault();
            if (window.location.pathname === "/") {
                window.dispatchEvent(new CustomEvent("toggle-rabbit-cinema"));
            } else {
                window.location.href = "/?rabbit=cinema";
            }
        };
    }
    bindNavRabbit();

    // Re-run after every View Transition swap
    document.addEventListener("astro:page-load", () => {
        closeNavMenu();
        bindNavBurger();
        updateActiveNav();
        bindNavRabbit();
    });
</script>
