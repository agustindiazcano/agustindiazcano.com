---
const links = [
    {
        name: "View Work",
        href: "/",
        match: "exact",
    },
    {
        name: "Projects",
        href: "/projects",
        match: "startsWith",
        icon: `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"/></svg>`,
    },
    {
        name: "Profile",
        href: "/profile",
        match: "startsWith",
        icon: `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>`,
    },
    {
        name: "Writing",
        href: "/writing",
        match: "startsWith",
        icon: `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3a2.828 2.828 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z"/></svg>`,
    },
    {
        name: "Research",
        href: "/research",
        match: "startsWith",
        icon: `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 2v7.31"/><path d="M14 9.3V1.99"/><path d="M8.5 2h7"/><path d="M14 9.3a14.98 14.98 0 0 0 4.63 7.85l3.27 3.27A1.5 1.5 0 0 1 20.8 23H3.2a1.5 1.5 0 0 1-1.1-2.58l3.27-3.27A14.98 14.98 0 0 0 10 9.3"/><path d="M6 16h12"/></svg>`,
    },
    {
        name: "GitHub",
        href: "/github",
        match: "startsWith",
        icon: `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>`,
    },
];
---

<nav id="site-nav" class="flex flex-wrap justify-center gap-2 w-full">
    {
        links.map((link) => (
            <a
                href={link.href}
                target={link.target || "_self"}
                data-nav-href={link.href}
                data-nav-match={link.match}
                class="nav-link px-4 py-2 rounded-full text-sm font-medium transition-all duration-300 flex items-center gap-2 border border-transparent bg-[#111] text-[#999] border-[#222] hover:text-white hover:border-[#444] hover:bg-[#1a1a1a]"
            >
                {link.icon && <Fragment set:html={link.icon} />}
                <span>{link.name}</span>
                {link.name === "View Work" && (
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="14"
                        height="14"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                    >
                        <path d="m6 9 6 6 6-6" />
                    </svg>
                )}
            </a>
        ))
    }
    <div class="relative group flex items-center self-center">
        <a
            id="nav-rabbit-btn"
            href="/juego31.html"
            target="_blank"
            rel="noopener noreferrer"
            class="nav-rabbit text-[#666] hover:text-white transition-all duration-300 p-2 rounded-full border border-[#222] bg-[#111] hover:border-[#444] hover:bg-[#1a1a1a] flex items-center justify-center"
            aria-label="Follow the white rabbit"
        >
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 16a3 3 0 0 1 2.24 5"/><path d="M18 12h.01"/><path d="M18 21h-8a4 4 0 0 1-4-4 7 7 0 0 1 7-7h.2L9.6 6.4a1 1 0 1 1 2.8-2.8L15.8 7h.2c3.3 0 6 2.7 6 6v1a2 2 0 0 1-2 2h-1a3 3 0 0 0-3 3"/><path d="M20 8.54V4a2 2 0 1 0-4 0v3"/><path d="M7.612 12.524a3 3 0 1 0-1.6 4.3"/></svg>
        </a>

        {/* Floating tooltip above rabbit */}
        <div
            class="pointer-events-none absolute bottom-full mb-2 left-1/2 -translate-x-1/2 opacity-0 group-hover:opacity-100 group-hover:-translate-y-1 transition-all duration-200 z-50 whitespace-nowrap px-2.5 py-1 text-xs font-mono tracking-tight text-white bg-[#111] border border-[#333] rounded-md shadow-lg shadow-black/60 flex items-center"
        >
            <span>Follow the white rabbit</span>
            <div class="absolute -bottom-1 left-1/2 -translate-x-1/2 w-2 h-2 bg-[#111] border-b border-r border-[#333] rotate-45"></div>
        </div>
    </div>
</nav>

<style>
    .rabbit-glow {
        animation: rabbitGlow 3s ease-in-out;
    }
    
    @keyframes rabbitGlow {
        0% { filter: drop-shadow(0 0 0px rgba(255, 255, 255, 0)); }
        20% { filter: drop-shadow(0 0 10px rgba(255, 255, 255, 0.9)); color: white; border-color: rgba(255, 255, 255, 0.5); }
        80% { filter: drop-shadow(0 0 10px rgba(255, 255, 255, 0.9)); color: white; border-color: rgba(255, 255, 255, 0.5); }
        100% { filter: drop-shadow(0 0 0px rgba(255, 255, 255, 0)); }
    }
</style>

<script>
    const ACTIVE = ["bg-white", "text-black", "shadow-lg", "shadow-white/5"];
    const INACTIVE = [
        "bg-[#111]",
        "text-[#999]",
        "border-[#222]",
        "hover:text-white",
        "hover:border-[#444]",
        "hover:bg-[#1a1a1a]",
    ];

    function updateActiveNav() {
        const pathname = window.location.pathname;
        const links =
            document.querySelectorAll<HTMLAnchorElement>("#site-nav .nav-link");

        links.forEach((link) => {
            const href = link.dataset.navHref ?? "";
            const match = link.dataset.navMatch ?? "startsWith";

            let isActive = false;
            if (match === "exact") {
                isActive = pathname === "/" || pathname === href;
            } else if (match === "startsWith") {
                isActive = href !== "/" && pathname.startsWith(href);
            }
            // "external" is always inactive

            link.classList.remove(...ACTIVE, ...INACTIVE);
            link.classList.add(...(isActive ? ACTIVE : INACTIVE));
        });
    }

    // Run immediately on hard load
    updateActiveNav();

    // Re-run after every View Transition swap
    document.addEventListener("astro:page-load", updateActiveNav);
</script>
