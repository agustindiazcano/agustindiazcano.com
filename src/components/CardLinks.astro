---
// Link buttons pinned to the bottom of an image card: GitHub and YouTube icons plus a text "Live" button.
// A button is only rendered when its URL is set. Must sit above the card's stretched link (z-20).
interface Props {
    title: string;
    github?: string | null;
    youtube?: string | null;
    live?: string | null;
}
const { title, github, youtube, live } = Astro.props;
---

{(github || youtube || live) && (
    <div class="relative z-20 flex items-center gap-2 pointer-events-auto">
        {github && (
            <a href={github} target="_blank" rel="noopener noreferrer" class="card-btn" aria-label={`${title} on GitHub`}>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
            </a>
        )}
        {youtube && (
            <a href={youtube} target="_blank" rel="noopener noreferrer" class="card-btn" aria-label={`${title} on YouTube`}>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2.5 17a24.12 24.12 0 0 1 0-10 2 2 0 0 1 1.4-1.4 49.56 49.56 0 0 1 16.2 0A2 2 0 0 1 21.5 7a24.12 24.12 0 0 1 0 10 2 2 0 0 1-1.4 1.4 49.55 49.55 0 0 1-16.2 0A2 2 0 0 1 2.5 17"/><path d="m10 15 5-3-5-3z"/></svg>
            </a>
        )}
        {live && (
            <a href={live} target="_blank" rel="noopener noreferrer" class="card-btn card-btn-text">Live</a>
        )}
    </div>
)}
