---
// Image / list view buttons. Works with <ItemsView />, which reads the same [data-set-view] buttons.
---

<div class="view-switch hidden sm:inline-flex items-center gap-1 p-1" role="group" aria-label="View">
    <button type="button" data-set-view="grid" aria-label="Image view" aria-pressed="true" title="Image view" class="view-btn">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
    </button>
    <button type="button" data-set-view="list" aria-label="List view" aria-pressed="false" title="List view" class="view-btn">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 6h13"/><path d="M8 12h13"/><path d="M8 18h13"/><path d="M3 6h.01"/><path d="M3 12h.01"/><path d="M3 18h.01"/></svg>
    </button>
</div>

<style is:global>
    .view-switch {
        border-radius: var(--glass-radius);
        background-color: rgba(8, 8, 10, 0.78);
        border: 1px solid rgba(255, 255, 255, 0.1);
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.18);
    }
    .view-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 0.4rem;
        border-radius: calc(var(--glass-radius) - 2px);
        color: #888;
        cursor: pointer;
        transition: color 0.5s ease, background-color 0.5s ease, box-shadow 0.5s ease;
    }
    .view-btn:hover {
        color: #ffffff;
        background-color: rgba(52, 52, 60, 0.7);
    }
    .view-btn[aria-pressed="true"] {
        color: #efd98a;
        background-color: rgba(44, 44, 52, 0.72);
        box-shadow: inset 0 0 12px rgba(239, 217, 138, 0.18);
    }
</style>
