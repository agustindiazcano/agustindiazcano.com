---
import Navigation from "./Navigation.astro";

interface Props {
    className?: string;
}

const { className = "" } = Astro.props;
---

<header
    class={`w-full flex flex-col items-center text-center mb-8 md:mb-10 ${className}`}
>
    <a href="/" class="group inline-block focus:outline-none">
        <h1
            class="h-[5.5rem] font-thin font-display tracking-normal text-[4rem] text-transparent bg-clip-text bg-gradient-to-b from-white to-[#777] mb-0 group-hover:from-white group-hover:to-[#aaa] transition-colors duration-200"
        >
            Agustin Diaz-Cano
        </h1>
    </a>
    <p class="text-base md:text-lg text-[#888] mb-0 max-w-2xl font-normal tracking-wider font-display">
        Software Engineer
    </p>
    <div class="mt-6 w-full flex justify-center">
        <Navigation />
    </div>
</header>
