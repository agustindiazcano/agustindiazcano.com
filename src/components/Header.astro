---
import Navigation from "./Navigation.astro";
import HeaderActions from "./HeaderActions.astro";

interface Props {
    className?: string;
    compact?: boolean;
}

const { className = "", compact = false } = Astro.props;
---

{compact ? (
<header class={`w-full grid grid-cols-1 lg:grid-cols-[1fr_auto_1fr] items-center gap-3 lg:gap-6 mb-4 md:mb-10 text-center lg:text-left ${className}`}>
    <div class="flex flex-col items-center lg:items-start text-center lg:text-left">
        <a href="/" class="group inline-block focus:outline-none">
            <span class="block font-thin font-display tracking-normal leading-tight text-[1.5rem] md:text-[1.85rem] text-transparent bg-clip-text bg-gradient-to-b from-white to-[#777] group-hover:from-white group-hover:to-[#aaa] transition-colors duration-200">
                Agustin Diaz-Cano
            </span>
        </a>
        <p class="text-xs md:text-sm text-[#888] mb-0 font-normal tracking-wider font-display mt-0.5">
            MS Candidate, Systems Engineering
        </p>
    </div>

    <Navigation compact />

    <HeaderActions class="hidden lg:flex" />
</header>
) : (
<header
    class={`w-full flex flex-col items-center text-center mb-4 md:mb-8 ${className}`}
>
    {/* Author Branding - Top-left on desktop (matching AI Usage on top-right), centered on mobile */}
    <div
        class="flex flex-col items-center lg:items-start text-center lg:text-left lg:absolute lg:top-2 lg:left-6 z-20 mb-3 lg:mb-0"
    >
        <a href="/" class="group inline-block focus:outline-none">
            <h1
                class="font-thin font-display tracking-normal leading-tight text-[1.5rem] md:text-[1.85rem] text-transparent bg-clip-text bg-gradient-to-b from-white to-[#777] group-hover:from-white group-hover:to-[#aaa] transition-colors duration-200"
            >
                Agustin Diaz-Cano
            </h1>
        </a>
        <p class="text-xs md:text-sm text-[#888] mb-0 font-normal tracking-wider font-display mt-0.5">
            MS Candidate, Systems Engineering
        </p>
    </div>

    <div class="mb-3 md:mb-4 w-full flex justify-center">
        <Navigation />
    </div>

    <div
        id="view-toggle-slot"
        class="flex flex-wrap items-center justify-center gap-2 mt-1 md:mt-2 empty:hidden"
    ></div>
</header>
)}
