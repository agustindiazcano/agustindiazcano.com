---
// Initial Loading Screen
---

<script is:inline>
  if (typeof sessionStorage !== 'undefined' && sessionStorage.getItem("home-loaded")) {
    document.documentElement.classList.add("skip-loading-screen");
  }
</script>

<div id="loading-screen-overlay" class="fixed inset-0 w-full h-[100vh] z-50 bg-[#05030d] overflow-hidden transition-opacity duration-700">
    <div class="space-loading">
        <div class="stars-loading" id="loading-stars"></div>
        <div class="orb-wrapper-loading" id="loading-orb">
            <div class="outer-glow-loading"></div>
            <div class="ring-loading"></div>
            <div class="ball-loading"></div>
        </div>
        <div class="blur-overlay-loading"></div>
    </div>
</div>

<style>
  :global(.skip-loading-screen) #loading-screen-overlay {
    display: none !important;
  }

  .space-loading {
    position: relative;
    width: 100vw;
    height: 100vh;
    background: radial-gradient(circle at 50% 45%, #3a1a5c 0%, #1f0f38 45%, #05030d 100%);
    overflow: hidden;
  }

  .stars-loading {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }

  :global(.stars-loading span) {
    position: absolute;
    background: #ffffff;
    border-radius: 50%;
    opacity: var(--o, 0.8);
  }

  .orb-wrapper-loading {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 700px;
    height: 700px;
    margin-top: -350px;
    margin-left: -350px;
    transform: scale(0.2);
    transform-origin: center center;
    transition: transform 1.15s cubic-bezier(0.61, 0, 0.15, 1);
    z-index: 2;
  }

  .orb-wrapper-loading.expand {
    transform: scale(7);
  }

  .outer-glow-loading {
    position: absolute;
    inset: -60px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(255,154,77,0.55) 0%, rgba(255,154,77,0.18) 55%, rgba(255,154,77,0) 100%);
    filter: blur(18px);
    animation: breathe-loading 4.5s ease-in-out infinite;
    animation-delay: -0.6s;
    transition: opacity 0.5s ease-out;
  }

  @keyframes breathe-loading {
    0%, 100% {
      transform: scale(1);
      opacity: 0.85;
    }
    50% {
      transform: scale(1.045);
      opacity: 1;
    }
  }

  .ring-loading {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      #04040a 0%,
      #04040a 30%,
      rgba(20,15,10,0.6) 38%,
      #fffdf2 46%,
      #fff3c4 56%,
      rgba(255,210,122,0.85) 66%,
      rgba(255,178,110,0.55) 78%,
      rgba(255,178,110,0.3) 88%,
      rgba(255,178,110,0.12) 95%,
      rgba(255,178,110,0) 100%
    );
    filter: blur(9px);
    animation: breathe-loading 4.5s ease-in-out infinite;
    transition: opacity 0.5s ease-out;
  }

  .orb-wrapper-loading.expand .outer-glow-loading,
  .orb-wrapper-loading.expand .ring-loading {
    opacity: 0;
  }
  
  .ball-loading {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 520px;
    height: 520px;
    border-radius: 50%;
    transform: translate(-50%, -50%);
    background: radial-gradient(circle at 42% 38%, #14141c 0%, #04040a 40%, rgba(4,4,10,0.9) 62%, rgba(4,4,10,0.4) 80%, rgba(4,4,10,0) 100%);
    filter: blur(10px);
  }

  .blur-overlay-loading {
    position: absolute;
    inset: 0;
    background: transparent;
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    z-index: 3;
    pointer-events: none;
  }
</style>

<script>
  document.addEventListener("astro:page-load", () => {
    const starsContainer = document.getElementById('loading-stars');
    if (starsContainer && !starsContainer.hasChildNodes()) {
      const total = 220;
      for (let i = 0; i < total; i++) {
        const s = document.createElement('span');
        const size = Math.random() * 2 + 0.6;
        s.style.width = size + 'px';
        s.style.height = size + 'px';
        s.style.top = Math.random() * 100 + '%';
        s.style.left = Math.random() * 100 + '%';
        s.style.setProperty('--o', (Math.random() * 0.7 + 0.3).toFixed(2));
        starsContainer.appendChild(s);
      }
    }

    const orb = document.getElementById('loading-orb');
    const screen = document.getElementById('loading-screen-overlay');
    const mainContent = document.getElementById('home-main-content');
    
    if (orb && screen) {
      if (sessionStorage.getItem("home-loaded")) {
        // Skip animation on subsequent visits
        screen.style.display = 'none';
        if (mainContent) {
          mainContent.style.transition = 'none'; // skip fade-in delay
          mainContent.classList.add('show');
        }
        return;
      }

      // Start expansion
      setTimeout(() => {
        orb.classList.add('expand');
      }, 450);

      orb.addEventListener('transitionend', (e) => {
        if (e.propertyName === 'transform') {
          // Fade out the loading screen
          screen.style.opacity = '0';
          screen.style.pointerEvents = 'none';
          sessionStorage.setItem("home-loaded", "true");

          // Trigger content reveal
          if (mainContent) {
            mainContent.classList.add('show');
          }
          
          // Completely hide it after fade out
          setTimeout(() => {
              screen.style.display = 'none';
          }, 700);
        }
      });
    }
  });
</script>
