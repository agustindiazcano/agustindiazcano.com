---
// First visit of the session: the black hole from far away, a fast approach to its center in 1.5s,
// a black screen, and only then the home loads. The animation itself lives in GargantuaBackground.astro.
---

{/* Black curtain: fully black at the end of the approach, then lifts to reveal the home */}
<div
  id="gargantua-intro-blackout"
  class="fixed inset-0 bg-black pointer-events-none z-50"
  style="display: none; opacity: 0;"
  aria-hidden="true"
></div>

<script is:inline>
  function applyIntroState() {
    var root = document.documentElement;
    var first = false;
    try {
      first = !sessionStorage.getItem("home-loaded");
    } catch (e) {}
    var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (first && !reduce) {
      root.classList.add("intro-active");
      root.classList.remove("skip-loading-screen");
    } else {
      root.classList.remove("intro-active");
      root.classList.add("skip-loading-screen");
    }
  }
  applyIntroState();
  document.addEventListener('astro:after-swap', applyIntroState);
</script>

<style is:global>
  /* While the intro runs the content stays hidden (it appears when the curtain lifts) */
  html.intro-active #site-header-container,
  html.intro-active #home-floating-usage,
  html.intro-active #home-main-content,
  html.intro-active #home-main-content.show {
    opacity: 0 !important;
    visibility: hidden !important;
    pointer-events: none !important;
  }
</style>

<script>
  function setupHome() {
    const root = document.documentElement;
    const mainContent = document.getElementById('home-main-content');
    const blackout = document.getElementById('gargantua-intro-blackout');

    if (!root.classList.contains('intro-active')) {
      mainContent?.classList.add('show');
      if (blackout) blackout.style.display = 'none';
      return;
    }

    // Safety net: if the engine never starts the intro (WebGL failed or the page is very slow), load the home anyway
    setTimeout(() => {
      if ((window as any).__introStarted) return;
      if (!root.classList.contains('intro-active')) return;
      try {
        sessionStorage.setItem('home-loaded', 'true');
      } catch (e) {}
      root.classList.remove('intro-active');
      root.classList.add('skip-loading-screen');
      mainContent?.classList.add('show');
      if (blackout) blackout.style.display = 'none';
    }, 6000);
  }
  document.addEventListener('astro:page-load', setupHome);
</script>
