---
// 3D Black Hole Initial Cosmic Intro
---

{/* Intro Blackout Curtain: plunged into total blackness crossing event horizon, then dissolves smoothly into normal site */}
<div 
  id="gargantua-intro-blackout" 
  class="fixed inset-0 bg-black pointer-events-none z-50 opacity-0 transition-opacity" 
  style="transition-duration: 550ms; transition-timing-function: cubic-bezier(0.16, 1, 0.3, 1);"
  aria-hidden="true"
></div>

<script is:inline>
  function applyIntroState() {
    try {
      if (sessionStorage.getItem("home-loaded")) {
        document.documentElement.classList.add("skip-loading-screen");
        document.documentElement.classList.remove("intro-active");
      } else {
        document.documentElement.classList.add("intro-active");
      }
    } catch (e) {
      document.documentElement.classList.add("skip-loading-screen");
    }
  }
  applyIntroState();
  document.addEventListener('astro:after-swap', applyIntroState);
</script>

<style is:global>
  /* During 3D Black Hole Intro: UI waits to render smoothly while cosmic approach flight plays with background blur */
  html.intro-active #site-header-container,
  html.intro-active #home-floating-usage,
  html.intro-active #home-main-content,
  html.intro-active #home-main-content.show {
    opacity: 0 !important;
    visibility: hidden !important;
    pointer-events: none !important;
  }
</style>

<script>
  function setupIntroFallback() {
    const blackout = document.getElementById('gargantua-intro-blackout');
    const mainContent = document.getElementById('home-main-content');
    let isFirstVisit = false;
    try {
      isFirstVisit = !sessionStorage.getItem("home-loaded");
    } catch (e) {
      isFirstVisit = false;
    }

    if (!isFirstVisit) {
      document.documentElement.classList.remove("intro-active");
      document.documentElement.classList.add("skip-loading-screen");
      if (blackout) blackout.style.display = 'none';
      if (mainContent) {
        mainContent.classList.add('show');
      }
      return;
    }

    // Safety fallback: if for any reason engine animation does not complete within 3.5s, force transition
    const fallbackTimer = setTimeout(() => {
      if (document.documentElement.classList.contains('intro-active')) {
        try {
          sessionStorage.setItem("home-loaded", "true");
        } catch (e) {}
        document.documentElement.classList.remove("intro-active");
        document.documentElement.classList.add("skip-loading-screen");
        if (blackout) {
          blackout.style.opacity = '0';
          setTimeout(() => { blackout.style.display = 'none'; }, 550);
        }
        if (mainContent) {
          mainContent.classList.add('show');
        }
      }
    }, 3500);

    window.addEventListener('beforeunload', () => clearTimeout(fallbackTimer), { once: true });
  }

  document.addEventListener("astro:page-load", setupIntroFallback);
</script>
